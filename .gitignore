# Temporary and binary files
# Editor backup files. NOTE this also matches a directory literally named `~`,
# which is how a stray one went unnoticed here for a month: a tilde only expands
# in a shell, unquoted, at the start of a word -- never from inside a variable,
# and never in a Docker Compose env file. `FINN_HOST_BUILD_DIR=~/builds`
# therefore produced a bind mount into a directory called `~`.
# docker/finn-env now expands every path it emits; see hostpath() there.
*~
*.py[cod]
*.so
*.cfg
!.isort.cfg
!setup.cfg
*.orig
*.log
*.pot
__pycache__/*
.cache/*
.*.swp
*.ipynb_checkpoints*

# Project files
.vscode
.ropeproject
.project
.pydevproject
.settings
.idea
tags

# Package files
*.egg
*.eggs/
.installed.cfg
*.egg-info

# Unittest and coverage
htmlcov/*
.coverage
.tox
junit.xml
coverage.xml
.pytest_cache/

# Build and docs folder/files
build/*
dist/*
sdist/*
docs/api/*
docs/_rst/*
docs/_build/*
cover/*
MANIFEST

# Jenkins workspace copy of the image provenance/digest that build-images.sh
# emits, staged here so archiveArtifacts can see it before it is copied to NFS.
/ci-image-metadata/

# Per-project virtualenvs
.venv*/

# SSH key dir mounted into Docker
/ssh_keys/

# PYNQ board files
/board_files/

# datasets for testing
/dataset/
/data/
*.csv

# Google Drive key for dashboard
/gdrive-key/

# generated files as part of end2end notebooks
/notebooks/end2end_example/**/*.onnx

# downloaded dep repos
/deps/

# Host-specific environment files from older/manual Compose workflows.
/.env

# Retained so caches from the retired user launcher do not become untracked.
/.finn-run.env

# Build scratch used by the Dev Container.
/.finn-build/

# Vendor runtime packages: supplied by the user, never redistributed by FINN.
# See docker/runtimes/README.md.
docker/packages/*.deb
docker/packages/*.rpm

# Exported Apptainer/Singularity images are generated build artifacts.
*.sif
