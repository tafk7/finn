# FINN dependency pins - single source of truth.
#
# Sourced by fetch-repos.sh (to populate the host checkout) and by
# docker/Dockerfile.finn (to build the baked wheels), so the commit a developer
# works against and the commit baked into the image can never disagree.
#
# Every pin is env-overridable and accepts any git ref - a SHA, a tag, or a
# branch name:
#
#   QONNX_COMMIT=my-feature-branch ./docker/run --deps live
#   BREVITAS_COMMIT=v0.11.0 ./docker/run --deps live -- quicktest.sh
#
# Refs are resolved with `git rev-parse <ref>^{commit}` rather than compared as
# strings, so a branch name tracks its tip at fetch time instead of being
# rejected for not looking like a SHA.
#
# This file is sourced, not executed: it must contain assignments only.

# --- Python packages ---------------------------------------------------------
# Imported by FINN, and co-developed often enough that fetch-repos.sh refuses to
# move them when the working tree is dirty. Present in every image tier.
: ${QONNX_URL:="https://github.com/fastmachinelearning/qonnx.git"}
: ${QONNX_COMMIT:="f5c9819bd00f01f41e70639b8461c8e4b39432f7"}
: ${QONNX_DIR:="qonnx"}

: ${FINN_EXP_URL:="https://github.com/Xilinx/finn-experimental.git"}
: ${FINN_EXP_COMMIT:="0724be21111a21f0d81a072fccc1c446e053f851"}
: ${FINN_EXP_DIR:="finn-experimental"}

: ${BREVITAS_URL:="https://github.com/Xilinx/brevitas.git"}
: ${BREVITAS_COMMIT:="aad4d5a293db6f2ec622a92a5d3278e47072453e"}
: ${BREVITAS_DIR:="brevitas"}

# --- Build data --------------------------------------------------------------
# Not Python packages and never imported: HLS C++ headers and Vivado board
# definitions, reached through FINN_HLSLIB_PATH / FINN_BOARD_FILES_PATH. They are
# present in the common image but consumed only by FPGA build flows.
: ${HLSLIB_URL:="https://github.com/Xilinx/finn-hlslib.git"}
: ${HLSLIB_COMMIT:="8d979e2bdced486dd25d26607d1ff5ae327ed6a8"}
: ${HLSLIB_DIR:="finn-hlslib"}

: ${AVNET_BDF_URL:="https://github.com/Avnet/bdf.git"}
: ${AVNET_BDF_COMMIT:="2d49cfc25766f07792c0b314489f21fe916b639b"}
: ${AVNET_BDF_DIR:="avnet-bdf"}

: ${XIL_BDF_URL:="https://github.com/Xilinx/XilinxBoardStore.git"}
: ${XIL_BDF_COMMIT:="8cf4bb674a919ac34e3d99d8d71a9e60af93d14e"}
: ${XIL_BDF_DIR:="xil-bdf"}

: ${RFSOC4x2_BDF_URL:="https://github.com/RealDigitalOrg/RFSoC4x2-BSP.git"}
: ${RFSOC4x2_BDF_COMMIT:="13fb6f6c02c7dfd7e4b336b18b959ad5115db696"}
: ${RFSOC4x2_BDF_DIR:="rfsoc4x2-bdf"}

: ${KV260_BDF_URL:="https://github.com/Xilinx/XilinxBoardStore.git"}
: ${KV260_BDF_COMMIT:="98e0d3efc901f0b974006bc4370c2a7ad8856c79"}
: ${KV260_BDF_DIR:="kv260-som-bdf"}
# Retained under its historical name for anything that referenced it directly.
KV260_SOM_BDF_DIR="$KV260_BDF_DIR"

: ${AUPZU3_BDF_URL:="https://github.com/RealDigitalOrg/aup-zu3-bsp.git"}
: ${AUPZU3_BDF_COMMIT:="b595ecdf37c7204129517de1773b0895bcdcc2ed"}
: ${AUPZU3_BDF_DIR:="aupzu3-8gb-bdf"}

# Cache checksum for the assembled deps/board_files folder. Regenerate after
# changing the board set or a board repository pin with:
#   find deps/board_files/ -type f -exec md5sum {} \; | sort -k 2 | md5sum
: ${EXP_BOARD_FILES_MD5:="221a7edc838f4236922afbd9b9a20f17"}

# Group membership, used by fetch-repos.sh to fetch one half without the other.
# Each entry is the name of the URL/COMMIT/DIR variable triple above.
FINN_DEP_GROUP_PYTHON="QONNX FINN_EXP BREVITAS"
FINN_DEP_GROUP_DATA="HLSLIB AVNET_BDF XIL_BDF RFSOC4x2_BDF KV260_BDF AUPZU3_BDF"
