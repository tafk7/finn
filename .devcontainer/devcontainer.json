{
  // FINN's portable development contract, for Dev Containers, Codespaces and
  // any agent tooling that reads this format.
  //
  // It points at compose's `dev` service deliberately. That service is held to
  // a hard contract: only the workspace is mounted from the host, and there is
  // no toolchain, licence, secret or device. Docker networking remains open;
  // the portable contract is about host mounts and capabilities, not egress.
  //
  // Vivado, Vitis and HLS work is NOT available here, and that is the point.
  // Those need host paths and a licence, which is explicit capability
  // escalation a human opts into:
  //
  //   ./docker/run --fpga
  //
  // There is deliberately no second devcontainer.json for the FPGA tiers. Dev
  // Containers is the right format for the portable default; a profile whose
  // whole nature is host-specific escalation is not portable, and pretending
  // otherwise in this file would just produce a config that fails on every
  // machine but one.
  "name": "FINN (dev)",

  "initializeCommand": "mkdir -p .finn-build",
  "dockerComposeFile": [
    "../compose.yaml",
    "compose.yaml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspace/finn",

  // docker/run renders the host uid into its Compose override. Dev Containers
  // performs its own uid mapping against the image's `agent` identity.
  "remoteUser": "agent",
  "updateRemoteUserUID": true,

  // Declared, not assumed: XRT and Vivado are x86-64 only, and the image
  // carries explicit x86-64 assumptions (the LSB loader symlink, the ncurses 5
  // backport).
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  // One-time preparation in a writable venv, using the image's dependency set.
  "postCreateCommand": "python -m venv --system-site-packages --without-pip .venv && .venv/bin/python -m pip install --use-pep517 --config-settings editable_mode=strict --no-deps --no-build-isolation -e .",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/finn/.venv/bin/python"
      }
    }
  }
}
