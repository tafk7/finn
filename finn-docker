# Check available disk space before operations
check_disk_space() {
    local required_gb="${1:-10}"  # Default 10GB
    local available_kb=$(df "$FINN_ROOT" | tail -1 | awk '{print $4}')
    local available_gb=$((available_kb / 1024 / 1024))
    
    if [ $available_gb -lt $required_gb ]; then
        recho "ERROR: Insufficient disk space"
        recho "Required: ${required_gb}GB, Available: ${available_gb}GB"
        recho "Location: $FINN_ROOT"
        exit 1
    else
        gecho "Disk space check passed: ${available_gb}GB available"
    fi
}

# Monitor container startup via log streaming
monitor_container_startup() {
    local container_name="$1"
    local timeout="${2:-300}"  # Default 5 minutes
    local start_time=$(date +%s)
    local show_progress="${FINN_SHOW_PROGRESS:-1}"
    
    gecho "Starting container and monitoring initialization..."
    
    # Create a temporary file to track completion
    local completion_file="/tmp/.monitor_${container_name}_$$"
    local progress_file="/tmp/.progress_${container_name}_$$"
    echo "0" > "$progress_file"
    
    # Progress bar function
    show_progress_bar() {
        local current=$1
        local total=$2
        local width=50
        local percentage=$((current * 100 / total))
        local filled=$((width * current / total))
        local empty=$((width - filled))
        
        if [ "$show_progress" = "1" ]; then
            printf "\r["
            printf "%${filled}s" | tr ' ' '='
            printf "%${empty}s" | tr ' ' ' '
            printf "] %3d%%" $percentage
        fi
    }
    
    # Start log monitoring in background
    {
        docker logs -f "$container_name" 2>&1 | while IFS= read -r line; do
            # Check for status messages
            if [[ "$line" =~ FINN_STATUS:(.+)$ ]]; then
                local status="${BASH_REMATCH[1]}"
                local status_parts=(${status//:/ })
                local status_type="${status_parts[0]}"
                local status_detail="${status_parts[1]:-}"
                
                case "$status_type" in
                    "INITIALIZING")
                        echo "10" > "$progress_file"
                        show_progress_bar 10 100
                        echo -e "\n→ Container initializing..."
                        ;;
                    "CHECKING_DEPENDENCIES")
                        echo "20" > "$progress_file"
                        show_progress_bar 20 100
                        echo -e "\n→ Checking dependencies..."
                        ;;
                    "FETCHING_DEPENDENCIES")
                        echo "30" > "$progress_file"
                        show_progress_bar 30 100
                        if [ -n "$status_detail" ]; then
                            echo -e "\n→ Fetching: $status_detail"
                        else
                            echo -e "\n→ Fetching dependency repositories..."
                        fi
                        ;;
                    "INSTALLING_PACKAGES")
                        echo "60" > "$progress_file"
                        show_progress_bar 60 100
                        if [ -n "$status_detail" ]; then
                            echo -e "\n→ Installing: $status_detail"
                        else
                            echo -e "\n→ Installing packages..."
                        fi
                        ;;
                    "VERIFYING")
                        echo "80" > "$progress_file"
                        show_progress_bar 80 100
                        echo -e "\n→ Verifying installation..."
                        ;;
                    "PROFILING")
                        # Show profiling info if enabled
                        if [ -n "$status_detail" ]; then
                            echo -e "\n  [PROFILE] $status_detail"
                        fi
                        ;;
                    "READY")
                        echo "100" > "$progress_file"
                        show_progress_bar 100 100
                        if [ -n "$status_detail" ] && [ "$status_detail" = "cached" ]; then
                            echo -e "\n✓ Container is ready! (fast cached startup)"
                        else
                            echo -e "\n✓ Container is ready!"
                        fi
                        echo "SUCCESS" > "$completion_file"
                        break
                        ;;
                    "ERROR")
                        recho "✗ Container initialization failed: $status_detail"
                        echo "ERROR:$status_detail" > "$completion_file"
                        break
                        ;;
                esac
            elif [[ "$line" =~ "FINN container ready" ]]; then
                # Fallback detection for ready state
                gecho "✓ Container is ready!"
                echo "SUCCESS" > "$completion_file"
                break
            elif [ "${FINN_SHOW_INIT_LOGS:-false}" = "true" ]; then
                # Show all logs if requested
                echo "  $line"
            fi
        done
    } &
    
    local monitor_pid=$!
    
    # Wait for completion or timeout
    local elapsed=0
    while [ $elapsed -lt $timeout ]; do
        if [ -f "$completion_file" ]; then
            local result=$(cat "$completion_file")
            kill $monitor_pid 2>/dev/null || true
            wait $monitor_pid 2>/dev/null || true
            rm -f "$completion_file"
            
            if [ "$result" = "SUCCESS" ]; then
                return 0
            else
                recho "Container initialization failed: ${result#ERROR:}"
                return 1
            fi
        fi
        
        # Check if container is still running
        if ! docker inspect "$container_name" --format='{{.State.Running}}' 2>/dev/null | grep -q "true"; then
            kill $monitor_pid 2>/dev/null || true
            wait $monitor_pid 2>/dev/null || true
            rm -f "$completion_file"
            recho "Container stopped unexpectedly during initialization"
            return 1
        fi
        
        sleep 2
        elapsed=$((elapsed + 2))
    done
    
    # Timeout reached
    kill $monitor_pid 2>/dev/null || true
    wait $monitor_pid 2>/dev/null || true
    rm -f "$completion_file" "$progress_file"
    recho "Container initialization timeout after ${timeout}s"
    return 1
}

get_container_status() {
    docker inspect "$DOCKER_INST_NAME" >/dev/null 2>&1
    if [ $? -eq 0 ]; then
        STATUS=$(docker inspect --format='{{.State.Status}}' "$DOCKER_INST_NAME")
        echo "$STATUS"
    else
        echo "not_found"
    fi
}

is_container_running() {
    STATUS=$(get_container_status)
    [ "$STATUS" = "running" ]
}

build_image() {
    # Check disk space before building (requires 15GB for builds)
    check_disk_space 15
    
    gecho "Building Docker image $FINN_DOCKER_TAG"
    
    OLD_PWD=$(pwd)
    cd $FINN_ROOT
    
    [ "$FINN_DOCKER_NO_CACHE" = "1" ] && FINN_DOCKER_BUILD_FLAGS+=" --no-cache"
    
    # Check if XRT needs to be copied
    if [ -d "$FINN_XRT_PATH" ]; then
        cp $FINN_XRT_PATH/$XRT_DEB_VERSION.deb .
        export LOCAL_XRT=1
    fi
    
    docker build -f docker/Dockerfile.finn \
        --build-arg XRT_DEB_VERSION=$XRT_DEB_VERSION \
        --build-arg SKIP_XRT=$FINN_SKIP_XRT_DOWNLOAD \
        --build-arg LOCAL_XRT=$LOCAL_XRT \
        --tag=$FINN_DOCKER_TAG \
        $FINN_DOCKER_BUILD_FLAGS .
    
    # Clean up XRT file if copied
    if [ ! -z "$LOCAL_XRT" ]; then
        rm -f $XRT_DEB_VERSION.deb
    fi
    
    cd $OLD_PWD
}

# Check for existing containers with the same name
check_container_conflicts() {
    local status=$(get_container_status)
    if [ "$status" != "not_found" ]; then
        becho "Found existing container $DOCKER_INST_NAME (status: $status)"
        if [ "$status" = "exited" ]; then
            becho "Will reuse existing container"
        fi
    fi
}

# Create container with the specified mode
create_container() {
    MODE="$1"
    
    # Validate Docker flags for security before proceeding
    validate_docker_flags
    
    # Check for container name conflicts
    check_container_conflicts
    
    gecho "Creating new container $DOCKER_INST_NAME"
    
    # Create necessary directories
    mkdir -p $FINN_HOST_BUILD_DIR
    mkdir -p $FINN_SSH_KEY_DIR
    mkdir -p $FINN_DEPS_DIR
    
    # Ensure git-based deps are checked out
    if [ "$FINN_SKIP_DEP_REPOS" = "0" ]; then
        gecho "Fetching dependency repositories..."
        $FINN_ROOT/docker/fetch-repos.sh
    fi
    
    # Build Docker command with all required options
    DOCKER_CMD="docker run"
    
    if [ "$MODE" = "daemon" ]; then
        DOCKER_CMD+=" -d -t"
    else
        DOCKER_CMD+=" -it --rm"
    fi
    
    DOCKER_CMD+=" --name $DOCKER_INST_NAME"
    DOCKER_CMD+=" --init --hostname $DOCKER_INST_NAME"
    DOCKER_CMD+=" -e SHELL=/bin/bash"
    DOCKER_CMD+=" -w $FINN_ROOT"
    
    # Essential volume mounts
    DOCKER_CMD+=" -v $FINN_ROOT:$FINN_ROOT"
    DOCKER_CMD+=" -v $FINN_HOST_BUILD_DIR:$FINN_HOST_BUILD_DIR"
    DOCKER_CMD+=" -v $FINN_DEPS_DIR:$FINN_DEPS_DIR"
    
    # Essential environment variables
    DOCKER_CMD+=" -e FINN_BUILD_DIR=$FINN_HOST_BUILD_DIR"
    DOCKER_CMD+=" -e FINN_ROOT=$FINN_ROOT"
    DOCKER_CMD+=" -e FINN_DEPS_DIR=$FINN_DEPS_DIR"
    DOCKER_CMD+=" -e FINN_SKIP_DEP_REPOS=$FINN_SKIP_DEP_REPOS"
    DOCKER_CMD+=" -e LOCALHOST_URL=$LOCALHOST_URL"
    DOCKER_CMD+=" -e NUM_DEFAULT_WORKERS=$NUM_DEFAULT_WORKERS"
    DOCKER_CMD+=" -e JUPYTER_PORT=$JUPYTER_PORT"
    DOCKER_CMD+=" -e NETRON_PORT=$NETRON_PORT"
    
    # User/permission setup (unless running as root)
    if [ "$FINN_DOCKER_RUN_AS_ROOT" = "0" ]; then
        # Only mount system files if they exist and are readable
        [ -r /etc/group ] && DOCKER_CMD+=" -v /etc/group:/etc/group:ro"
        [ -r /etc/passwd ] && DOCKER_CMD+=" -v /etc/passwd:/etc/passwd:ro"
        # Security: Don't mount /etc/shadow
        [ -d /etc/sudoers.d ] && DOCKER_CMD+=" -v /etc/sudoers.d:/etc/sudoers.d:ro"
        
        # SSH key directory mount for non-root user
        if [ -d "$FINN_SSH_KEY_DIR" ]; then
            DOCKER_CMD+=" -v $FINN_SSH_KEY_DIR:$HOME/.ssh"
        fi
        DOCKER_CMD+=" --user $(id -u):$(id -g)"
    else
        # SSH key directory mount for root user
        if [ -d "$FINN_SSH_KEY_DIR" ]; then
            DOCKER_CMD+=" -v $FINN_SSH_KEY_DIR:/root/.ssh"
        fi
    fi
    
    # Dependency and Xilinx setup
    DOCKER_CMD+=" -e VIVADO_IP_CACHE=$VIVADO_IP_CACHE"
    DOCKER_CMD+=" -e OHMYXILINX=$OHMYXILINX"
    
    # Xilinx workarounds
    DOCKER_CMD+=" -e LD_PRELOAD=/lib/x86_64-linux-gnu/libudev.so.1"
    DOCKER_CMD+=" -e XILINX_LOCAL_USER_DATA=no"
    
    # Xilinx tools (if available)
    if [ ! -z "$FINN_XILINX_PATH" ]; then
        VIVADO_PATH="$FINN_XILINX_PATH/Vivado/$FINN_XILINX_VERSION"
        VITIS_PATH="$FINN_XILINX_PATH/Vitis/$FINN_XILINX_VERSION"
        HLS_PATH="$FINN_XILINX_PATH/Vitis_HLS/$FINN_XILINX_VERSION"
        
        DOCKER_CMD+=" -v $FINN_XILINX_PATH:$FINN_XILINX_PATH"
        [ -d "$VIVADO_PATH" ] && DOCKER_CMD+=" -e XILINX_VIVADO=$VIVADO_PATH -e VIVADO_PATH=$VIVADO_PATH"
        [ -d "$HLS_PATH" ] && DOCKER_CMD+=" -e HLS_PATH=$HLS_PATH"
        [ -d "$VITIS_PATH" ] && DOCKER_CMD+=" -e VITIS_PATH=$VITIS_PATH"
        [ -d "$PLATFORM_REPO_PATHS" ] && DOCKER_CMD+=" -v $PLATFORM_REPO_PATHS:$PLATFORM_REPO_PATHS -e PLATFORM_REPO_PATHS=$PLATFORM_REPO_PATHS"
    fi
    
    # Port forwarding for services
    DOCKER_CMD+=" -p $JUPYTER_PORT:$JUPYTER_PORT"
    DOCKER_CMD+=" -p $NETRON_PORT:$NETRON_PORT"
    
    # GPU support
    if [ "$FINN_DOCKER_GPU" != 0 ]; then
        gecho "nvidia-docker detected, enabling GPUs"
        if [ ! -z "$NVIDIA_VISIBLE_DEVICES" ]; then
            DOCKER_CMD+=" --runtime nvidia -e NVIDIA_VISIBLE_DEVICES=$NVIDIA_VISIBLE_DEVICES"
        else
            DOCKER_CMD+=" --gpus all"
        fi
    fi
    
    # ImageNet dataset if available
    if [ ! -z "$IMAGENET_VAL_PATH" ]; then
        DOCKER_CMD+=" -v $IMAGENET_VAL_PATH:$IMAGENET_VAL_PATH"
        DOCKER_CMD+=" -e IMAGENET_VAL_PATH=$IMAGENET_VAL_PATH"
    fi
    
    # Additional flags from FINN_DOCKER_EXTRA and other sources
    DOCKER_CMD+=" $FINN_DOCKER_EXTRA $FINN_DOCKER_FLAGS"
    
    # Image and command
    if [ "$MODE" = "daemon" ]; then
        # Use proper entrypoint with daemon mode
        DOCKER_CMD+=" -e FINN_CONTAINER_MODE=daemon"
        DOCKER_CMD+=" $FINN_DOCKER_TAG"
        gecho "Starting daemon container..."
        # Execute with bash to keep container running
        RESULT=$($DOCKER_CMD bash -c "while true; do sleep 3600; done")
        DOCKER_EXIT_CODE=$?
        
        # Wait a moment and check if container actually started
        sleep 2
        FINAL_STATUS=$(get_container_status)
        
        if [ "$FINAL_STATUS" != "running" ]; then
            recho "Container failed to start properly. Status: $FINAL_STATUS"
            echo "=== Container logs ===" >&2
            docker logs "$DOCKER_INST_NAME" 2>&1 || echo "No logs available" >&2
            return 1
        else
            # For now, just mark as ready since we don't have the new entrypoint yet
            gecho "Container started successfully in daemon mode"
            return 0
        fi
    else
        DOCKER_CMD+=" $FINN_DOCKER_TAG bash"
        gecho "Starting interactive container..."
        exec $DOCKER_CMD
    fi
}

# Common container setup logic
setup_container_if_needed() {
    STATUS=$(get_container_status)
    
    if [ "$STATUS" = "running" ]; then
        return 0
    elif [ "$STATUS" = "exited" ]; then
        gecho "Starting existing container $DOCKER_INST_NAME"
        docker start "$DOCKER_INST_NAME"
        return $?
    fi
    
    # Build image if it doesn't exist or if not using prebuilt
    if [ "$FINN_DOCKER_PREBUILT" = "0" ]; then
        build_image
    fi
    
    # Create the container
    create_container "$1"
    return $?
}

# Initialize persistent container
init_container() {
    setup_container_if_needed "daemon"
}

# Execute command in container
exec_in_container() {
    if ! is_container_running; then
        recho "Container $DOCKER_INST_NAME is not running. Start it first with: $0 init"
        return 1
    fi
    
    if [ $# -eq 0 ]; then
        recho "No command specified for exec"
        return 1
    fi
    
    # Check if we need to change working directory
    local WORK_DIR=""
    if [ ! -z "$FINN_WORK_DIR" ]; then
        WORK_DIR="-w $FINN_WORK_DIR"
    elif [ "$PWD" != "$FINN_ROOT" ] && [[ "$PWD" == "$FINN_ROOT"* ]]; then
        # If we're in a subdirectory of FINN_ROOT, use that as working directory
        WORK_DIR="-w $PWD"
    fi
    
    # Execute command using fast exec entrypoint
    docker exec -e FINN_FAST_EXEC=1 $WORK_DIR "$DOCKER_INST_NAME" /usr/local/bin/entrypoint_exec.sh bash -c "$*"
    return $?
}

# Open interactive shell
open_shell() {
    if ! is_container_running; then
        recho "Container $DOCKER_INST_NAME is not running. Start it first with: $0 init"
        return 1
    fi
    
    gecho "Opening shell in container $DOCKER_INST_NAME"
    docker exec -it "$DOCKER_INST_NAME" bash
}

# Stop container
stop_container() {
    if is_container_running; then
        gecho "Stopping container $DOCKER_INST_NAME"
        docker stop "$DOCKER_INST_NAME"
    else
        yecho "Container $DOCKER_INST_NAME is not running"
    fi
}

# Show container status
show_status() {
    STATUS=$(get_container_status)
    case "$STATUS" in
        "running")
            gecho "Container $DOCKER_INST_NAME is running"
            docker ps --filter "name=$DOCKER_INST_NAME" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
            ;;
        "exited")
            yecho "Container $DOCKER_INST_NAME exists but is stopped"
            ;;
        "not_found")
            recho "Container $DOCKER_INST_NAME does not exist"
            ;;
        *)
            yecho "Container $DOCKER_INST_NAME status: $STATUS"
            ;;
    esac
}

# Show container logs
show_logs() {
    docker logs "$DOCKER_INST_NAME" "$@"
}

# Remove container
cleanup_container() {
    STATUS=$(get_container_status)
    if [ "$STATUS" != "not_found" ]; then
        gecho "Removing container $DOCKER_INST_NAME"
        docker rm -f "$DOCKER_INST_NAME"
    else
        yecho "Container $DOCKER_INST_NAME does not exist"
    fi
}

# Handle legacy commands for backward compatibility
handle_legacy_command() {
    case "$1" in
        "test")
            gecho "Running test suite (all tests)"
            exec_in_container "pytest"
            ;;
        "quicktest")
            gecho "Running test suite (non-Vivado, non-slow tests)"
            exec_in_container "quicktest.sh"
            ;;
        "notebook")
            gecho "Running Jupyter notebook server"
            local JUPYTER_PASSWD_ARG=""
            if [ ! -z "$JUPYTER_PASSWD_HASH" ]; then
                JUPYTER_PASSWD_ARG="--NotebookApp.password='$JUPYTER_PASSWD_HASH'"
            fi
            exec_in_container "jupyter notebook --allow-root --no-browser --ip=0.0.0.0 --port $JUPYTER_PORT $JUPYTER_PASSWD_ARG notebooks"
            ;;
        "build_dataflow")
            shift
            if [ -z "$1" ]; then
                recho "Error: build_dataflow requires a directory argument"
                exit 1
            fi
            BUILD_DATAFLOW_DIR=$(readlink -f "$1")
            gecho "Running build_dataflow for folder $BUILD_DATAFLOW_DIR"
            exec_in_container "cd $BUILD_DATAFLOW_DIR && build_dataflow ."
            ;;
        "build_custom")
            shift
            if [ -z "$1" ]; then
                recho "Error: build_custom requires a directory argument"
                exit 1
            fi
            BUILD_CUSTOM_DIR=$(readlink -f "$1")
            FLOW_NAME=${2:-build}
            shift 2
            gecho "Running build_custom: $BUILD_CUSTOM_DIR/$FLOW_NAME.py"
            exec_in_container "cd $BUILD_CUSTOM_DIR && python -mpdb -cc -cq $FLOW_NAME.py $@"
            ;;
        *)
            return 1
            ;;
    esac
    return 0
}

# Main command handling
case "${1:-help}" in
    "init")
        init_container
        ;;
    "exec")
        shift
        exec_in_container "$@"
        ;;
    "shell")
        open_shell
        ;;
    "build")
        build_image
        ;;
    "stop")
        stop_container
        ;;
    "status")
        show_status
        ;;
    "logs")
        shift
        show_logs "$@"
        ;;
    "clean"|"cleanup")
        cleanup_container
        ;;
    "verify")
        if is_container_running; then
            exec_in_container "python3 /usr/local/bin/verify_installation.py"
        else
            recho "Container not running. Start it first with: $0 init"
            exit 1
        fi
        ;;
    "health"|"health-check")
        if is_container_running; then
            exec_in_container "python3 /usr/local/bin/health_check.py"
        else
            recho "Container not running. Start it first with: $0 init"
            exit 1
        fi
        ;;
    "help"|"-h"|"--help")
        show_help
        ;;
    *)
        # Try legacy commands first
        if handle_legacy_command "$@"; then
            exit $?
        fi
        
        # Check for special shortcuts
        case "$1" in
            "make")
                # Make target support
                shift
                if [ -z "$1" ]; then
                    exec_in_container "make"
                else
                    exec_in_container "make $*"
                fi
                ;;
            "pytest")
                # Pytest shortcut with common options
                shift
                if [ -z "$1" ]; then
                    exec_in_container "pytest"
                else
                    exec_in_container "pytest $*"
                fi
                ;;
            "python"|"python3")
                # Python with proper environment
                shift
                exec_in_container "python3 $*"
                ;;
            "build")
                # Build shortcut
                shift
                if [ -z "$1" ]; then
                    recho "Error: build requires a build script path"
                    exit 1
                fi
                BUILD_SCRIPT="$1"
                shift
                exec_in_container "cd $(dirname $BUILD_SCRIPT) && python3 $(basename $BUILD_SCRIPT) $*"
                ;;
            *)
                # If not a special command, try to execute directly
                if [ -n "$1" ]; then
                    gecho "Running container with passed arguments"
                    exec_in_container "$@"
                else
                    show_help
                    exit 1
                fi
                ;;
        esac
        ;;
esac