#!/bin/bash
# FINN Container Management Script
# Provides utilities for managing persistent FINN containers
# Based on Brainsmith's robust container orchestration architecture

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

gecho () { echo -e "${GREEN}$1${NC}"; }
recho () { echo -e "${RED}$1${NC}"; }
yecho () { echo -e "${YELLOW}$1${NC}"; }
becho () { echo -e "${BLUE}$1${NC}"; }

# Auto-detect FINN directory (where this script lives)
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
export FINN_ROOT=$(readlink -f "$SCRIPT_DIR")

# Generate container name based on FINN directory (no timestamp for persistence)
FINN_DIR_HASH=$(echo "$FINN_ROOT" | md5sum | cut -d' ' -f1 | head -c 8)
DOCKER_UNAME=$(id -un)
DOCKER_INST_NAME="finn_dev_${DOCKER_UNAME}_${FINN_DIR_HASH}"
DOCKER_INST_NAME="${DOCKER_INST_NAME,,}"

# Debug output for container name generation (only if FINN_DEBUG is set)
debug() {
    [ "${FINN_DEBUG:-0}" = "1" ] && echo "DEBUG: $1" >&2
}

# Set Xilinx environment defaults with bashrc fallback
if [ -z "$FINN_XILINX_PATH" ] && [ -f "$HOME/.bashrc" ]; then
    FINN_XILINX_PATH=$(grep -E "^export FINN_XILINX_PATH=" "$HOME/.bashrc" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | head -1)
fi
: ${FINN_XILINX_PATH="/opt/Xilinx"}

if [ -z "$FINN_XILINX_VERSION" ] && [ -f "$HOME/.bashrc" ]; then
    FINN_XILINX_VERSION=$(grep -E "^export FINN_XILINX_VERSION=" "$HOME/.bashrc" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | head -1)
fi
: ${FINN_XILINX_VERSION="2022.2"}

if [ -z "$FINN_DOCKER_EXTRA" ] && [ -f "$HOME/.bashrc" ]; then
    FINN_DOCKER_EXTRA=$(grep -E "^export FINN_DOCKER_EXTRA=" "$HOME/.bashrc" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | head -1)
fi
: ${FINN_DOCKER_EXTRA=""}

# Handle Docker tag
if [ -z "$FINN_DOCKER_TAG" ]; then
    # Try git describe first, fallback to commit hash
    GIT_TAG=$(cd $FINN_ROOT; git describe --always --tags --dirty 2>/dev/null)
    if [ -n "$GIT_TAG" ]; then
        FINN_DOCKER_TAG="xilinx/finn:$GIT_TAG"
    else
        # Fallback for when git is not available
        FINN_DOCKER_TAG="xilinx/finn:latest"
    fi
fi

# Environment defaults
: ${LOCALHOST_URL="localhost"}
: ${JUPYTER_PORT=8888}
: ${NETRON_PORT=8081}
: ${NUM_DEFAULT_WORKERS=4}
: ${NVIDIA_VISIBLE_DEVICES=""}
: ${FINN_HOST_BUILD_DIR="/tmp/$DOCKER_INST_NAME"}
: ${FINN_DEPS_DIR="$FINN_ROOT/deps"}
: ${FINN_SSH_KEY_DIR="$FINN_ROOT/ssh_keys"}
: ${PLATFORM_REPO_PATHS="/opt/xilinx/platforms"}
: ${OHMYXILINX="${FINN_DEPS_DIR}/oh-my-xilinx"}
: ${VIVADO_IP_CACHE=$FINN_HOST_BUILD_DIR/vivado_ip_cache}
: ${DOCKER_BUILDKIT="1"}
: ${FINN_DOCKER_PREBUILT="0"}
: ${FINN_DOCKER_NO_CACHE="0"}
: ${FINN_SKIP_DEP_REPOS="0"}
: ${FINN_DOCKER_RUN_AS_ROOT="0"}
: ${FINN_DOCKER_GPU="$(docker info 2>/dev/null | grep nvidia | wc -m)"}
: ${FINN_DOCKER_BUILD_FLAGS=""}
: ${FINN_DOCKER_FLAGS=""}
: ${XRT_DEB_VERSION="xrt_202220.2.14.354_22.04-amd64-xrt"}

# Source error handler if available
if [ -f "$SCRIPT_DIR/docker/error_handler.sh" ]; then
    source "$SCRIPT_DIR/docker/error_handler.sh"
else
    # Fallback error handler
    handle_error() {
        local code=$1
        local msg=$2
        recho "ERROR $code: $msg"
        exit $code
    }
fi

# Validate Docker flags for security
validate_docker_flags() {
    if [[ "$FINN_DOCKER_FLAGS" =~ "/var/run/docker.sock" ]] || \
       [[ "$FINN_DOCKER_EXTRA" =~ "/var/run/docker.sock" ]]; then
        handle_error 10 "Mounting Docker socket is not allowed for security reasons" "Security validation"
    fi
}

