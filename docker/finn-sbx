#!/usr/bin/env bash
# Compatibility entry point. Prefer: ./docker/run --backend sbx

set -euo pipefail
DIR=$(dirname "$(readlink -f "$0")")
args=(--backend sbx)
case "${1:-}" in
    -h|--help) exec "$DIR/run" --help ;;
    rm)
        shift
        args+=(--remove)
        case "${1:-dev}" in
            build) args+=(--fpga); shift || true ;;
            build-xrt) args+=(--fpga --runtime xrt); shift || true ;;
            dev) shift || true ;;
        esac
        ;;
    build) args+=(--fpga); shift ;;
    build-xrt) args+=(--fpga --runtime xrt); shift ;;
    dev) shift ;;
esac
[ "${1:-}" = "--" ] && shift
exec "$DIR/run" "${args[@]}" -- "$@"
