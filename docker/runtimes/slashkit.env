# slashkit — the linker used by the FINN Slash flow.
#
# supply only. AMD distributes this directly, not from a public URL.
#
#   cp slashkit.deb <finn>/docker/packages/slashkit.deb
#   FINN_RUNTIMES=xrt,slash,slashkit docker buildx bake
#
# A manifest, not a COPY of whatever file is present: selecting it puts it in the
# image's tag, and a missing package fails the build.
SOURCE=supply
FILES=slashkit.deb
