# v80++ — AMD's V80 preview package.
#
# supply only. AMD distributes this directly, not from a public URL.
#
#   cp v80pp.deb <finn>/docker/packages/v80pp.deb
#   FINN_RUNTIMES=xrt,v80pp docker buildx bake -f docker-bake.hcl finn-runtime
#
# This used to be a bare `COPY v80pp.de[b]` in the build-xrt stage. That baked
# the package when the file happened to be present and silently did not when it
# was absent, and the tag was identical either way -- two materially different
# images under one name. Naming it here puts it in the tag.
SOURCE=supply
FILES=v80pp.deb
