# XRT — Xilinx Runtime. Vitis / Alveo targets.
#
# FINN links against this: alveo_build.py asserts XILINX_XRT is set, and
# make_driver.py execs xclbinutil. It is NOT needed for rtlsim, which uses
# Vivado's xsim.
#
# fetch, not supply. AMD publishes a stable versioned URL, FINN's own code hard
# depends on XRT, and CI publishes this image unattended and cannot be handed a
# file. Override with SOURCE=supply and drop your own deb in docker/packages/
# when you need a version AMD no longer serves.
#
# Host half: the xocl and xclmgmt kernel modules. Install them on the host.
#
# The name encodes the target release and architecture, and EXPECT_OS below is
# checked against the image. Do not change one without the other.
#
#   xrt_202420.2.18.179_22.04-amd64-xrt
#       └ version ──┘ └ OS ┘ └arch┘
#
SOURCE=fetch
DEB=xrt_202420.2.18.179_22.04-amd64-xrt
URL=https://download.amd.com/opendownload/xrt/${DEB}.deb
FALLBACK_URL=https://www.xilinx.com/bin/public/openDownload?filename=${DEB}.deb
SHA256=a78fca1fc155c37c9e6e8ff190253cf8f0731d42d282a91f3e7475613de5b46c
EXPECT_OS=22.04
