#!/usr/bin/env bash
# Run FINN under Apptainer or Singularity.
#
#   docker/run-apptainer [-- command...]
#   docker/run-apptainer prepare             prepare the cached .sif only
#   docker/run-apptainer -- vivado -version  run one command
#   docker/run-apptainer rm                  delete the cached .sif
#
# For machines where Docker is not available -- typically shared HPC, where a
# root daemon is not permitted. Apptainer needs no daemon and no privilege.
#
# SCOPE: this does the two things the tool cannot do for itself -- convert a
# locally built image into a .sif, and turn `docker/config inspect` into bind and
# environment arguments. Everything else is Apptainer's own behaviour.
#
# THIS IS NOT A CONTAINMENT BOUNDARY. Read the next section before using it for
# anything you would otherwise use the sbx sandbox for.
#
# ---------------------------------------------------------------------------
# MEASURED BEHAVIOUR, against singularity-ce 4.1.1
# ---------------------------------------------------------------------------
# Apptainer is an HPC tool. It assumes it is running your code on your behalf,
# so it is deliberately permeable in ways Docker is not. Verified on this host:
#
#   You are yourself.       uid 50113526, with every one of your host groups.
#                           No uid mapping, so no permission mismatch on a bind
#                           mount -- the problem that bites Docker Compose.
#   $HOME is mounted.       Which means a Xilinx installation under $HOME is
#                           visible to EVERY tier, including dev. On this host
#                           `vivado` ran from the DEV image, because the tools
#                           live in /home/tkeller/Xilinx.
#   $PWD and /tmp mounted.  So FINN_ROOT resolves from cwd with no help, and
#                           FINN_BUILD_DIR lands on the host /tmp.
#   Host environment is inherited WHOLESALE. XILINXD_LICENSE_FILE from the
#                           invoking shell reaches the container untouched.
#   The root filesystem is read-only.
#   The network is the host's. No namespace, so no port publishing.
#
# The consequence worth stating plainly: **this lane cannot withhold anything.**
# The toolchain and the licence arrive through $HOME and the inherited
# environment whatever the image contains. That is why there is no tier here --
# see the argument block below. For isolation, this way of running belongs
# beside the bare host, not beside Docker.
#
# --cleanenv below is therefore for PREDICTABILITY, not security. It stops the
# invoking shell from silently changing what runs, so the environment is
# exactly what docker/config resolved. It does not make this a sandbox, and nothing
# here can.

set -euo pipefail

SCRIPT=$(readlink -f "$0")
DOCKER_DIR=$(dirname "$SCRIPT")
REPO=$(dirname "$DOCKER_DIR")

# Capture the CALLER's directory before moving to the repo. Apptainer starts the
# container in $PWD, and a user running `finn-apptainer build -- vivado -source
# x.tcl` from a build directory expects to find x.tcl. Using $PWD after the `cd`
# below silently starts every command in the repo root instead, and the symptom
# is "couldn't read file" naming a file that plainly exists.
CALLER_PWD="$PWD"
cd "$REPO"

# gecho/recho/yecho, finn_git_describe, finn_bake_target, finn_bake_tag.
# shellcheck source=/dev/null
. "$DOCKER_DIR/lib.sh"

# apptainer first: it is the current name. Ubuntu ships the Sylabs fork as
# `singularity` (singularity-ce), and the CLI is compatible for what we use.
RUNTIME=""
for candidate in apptainer singularity; do
    command -v "$candidate" >/dev/null 2>&1 && { RUNTIME="$candidate"; break; }
done
[ -n "$RUNTIME" ] || {
    recho "Neither apptainer nor singularity found on PATH."
    recho "  Ubuntu:  sudo apt install singularity-container"
    recho "  Or:      https://github.com/apptainer/apptainer/releases"
    exit 1
}

# --------------------------------------------------------------------------
# Arguments
# --------------------------------------------------------------------------

PREPARE=0
if [ "${1:-}" = "prepare" ]; then PREPARE=1; shift; fi
REMOVE=0
if [ "${1:-}" = "rm" ]; then REMOVE=1; shift; fi

# Accelerator stacks to bake in. Empty is the base image.
# See docker/runtimes/README.md.
: "${FINN_RUNTIMES:=}"
: "${FINN_DEPS:=frozen}"

# THERE IS NO TIER HERE, and that is not an omission.
#
# A tier is a set of grants: no toolchain mount, no licence, no egress. This
# runtime cannot withhold any of them. Read the header: $HOME and $PWD are
# mounted automatically, the host environment is inherited wholesale, and the
# network is the host's with no namespace. On this machine `vivado` ran out of
# the narrow image because the tools live under /home/tkeller/Xilinx.
#
# So a `dev` tier here would be a claim we cannot keep. This resolves --tier
# build and uses whatever the host actually has; when the host has no
# toolchain, the mount list is simply empty.
#
# Legacy positional tiers are still accepted by the compatibility entry points.
case "${1:-}" in
    dev)
        yecho "This lane cannot withhold the toolchain -- \$HOME is mounted and the"
        yecho "host environment is inherited. Ignoring 'dev'; use docker/run --backend sbx for"
        yecho "a sandbox that actually enforces it."
        shift
        ;;
    build) shift ;;
    build-xrt)
        shift
        FINN_RUNTIMES="${FINN_RUNTIMES:+$FINN_RUNTIMES,}xrt"
        ;;
esac
[ "${1:-}" = "--" ] && shift
FINN_RUNTIMES=$(finn_normalize_runtimes "$FINN_RUNTIMES")
export FINN_RUNTIMES

# --------------------------------------------------------------------------
# The .sif
# --------------------------------------------------------------------------

GIT_DESCRIBE=$(finn_git_describe)
export GIT_DESCRIBE

# The tier does NOT appear in the target. There is one image; the tier decides
# binds and environment, further down. The runtime set DOES appear: it is image
# content.
BAKE_TARGET=$(finn_bake_target "$FINN_RUNTIMES")
TAG=$(finn_bake_tag "$BAKE_TARGET")
[ -n "$TAG" ] || { recho "could not resolve a tag for $BAKE_TARGET"; exit 1; }

# Keyed on the tag, so a rebuild produces a new .sif rather than reusing a stale
# one. Under the cache directory because it is regenerable -- deleting it costs
# time, never data.
SIF_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/finn/sif"
SIF="$SIF_DIR/$(printf '%s' "$TAG" | tr '/:' '__').sif"

if [ "$REMOVE" = 1 ]; then
    rm -f "$SIF"
    gecho "Removed $SIF"
    exit 0
fi

# FINN_SINGULARITY keeps its original meaning: a path to a .sif you built
# yourself. It used to be the ONLY way to use this path, because nothing here
# could build one.
if [ -n "${FINN_SINGULARITY:-}" ]; then
    [ -f "$FINN_SINGULARITY" ] || { recho "FINN_SINGULARITY=$FINN_SINGULARITY does not exist"; exit 1; }
    SIF="$FINN_SINGULARITY"
    gecho "Using the image given by FINN_SINGULARITY: $SIF"
elif [ -f "$SIF" ] && [ "${FINN_CONTAINER_REBUILD:-0}" != 1 ]; then
    gecho "Using the cached image $SIF"
    gecho "(use ./docker/build --backend apptainer --rebuild to replace it)"
else
    [ "${FINN_CONTAINER_NO_BUILD:-0}" != 1 ] || {
        recho "No prepared SIF at $SIF"
        recho "Run ./docker/build --backend apptainer first, or omit --no-build."
        exit 1
    }
    # Conversion needs Docker, which the machine that RUNS this may not have.
    # That is normal and expected: build the .sif on a machine with Docker, copy
    # the single file to the cluster, and point FINN_SINGULARITY at it there.
    command -v docker >/dev/null 2>&1 || {
        recho "No cached .sif at $SIF, and Docker is not available to build one."
        recho "Build it on a machine that has Docker:"
        recho "  ./docker/build --backend apptainer"
        recho "then copy the .sif here and set FINN_SINGULARITY to its path."
        exit 1
    }
    BUILD_ARGS=()
    [ "${FINN_CONTAINER_REBUILD:-0}" = 1 ] && BUILD_ARGS+=(--no-cache)
    finn_bake_build "$BAKE_TARGET" "${BUILD_ARGS[@]}" || exit 1

    mkdir -p "$SIF_DIR"
    TAR=$(mktemp -t finn-sif-XXXXXX.tar)
    trap 'rm -f "$TAR"' EXIT
    # Measured: about 1 minute to export and 7 to convert, for the dev tier.
    # The result is roughly a quarter of the Docker image, because a SIF is a
    # compressed squashfs.
    gecho "Exporting $TAG (about a minute)"
    docker save "$TAG" -o "$TAR" || { recho "docker save failed"; exit 1; }
    gecho "Converting to $SIF (several minutes; this is the slow step)"
    "$RUNTIME" build --force "$SIF" "docker-archive://$TAR" \
        || { recho "$RUNTIME build failed"; exit 1; }
    rm -f "$TAR"; trap - EXIT
fi

if [ "$PREPARE" = 1 ]; then
    gecho "Prepared Apptainer image: $SIF"
    exit 0
fi

# --------------------------------------------------------------------------
# Binds and environment, from the one resolver
# --------------------------------------------------------------------------

# --backend apptainer, which forces the mirror workspace policy. Apptainer
# mounts every path at its own location and cannot remap, so a fixed FINN_ROOT
# would name a directory that was never mounted -- `import finn` then fails with
# ModuleNotFoundError and nothing points at the cause.
INSPECT=$("$REPO/docker/config" inspect --tier auto --backend apptainer --format json) || {
    recho "docker/config inspect failed"; exit 1
}

ARGS=()
# --cleanenv: see the header. Apptainer inherits the whole invoking environment
# otherwise, so what runs would depend on the caller's shell.
ARGS+=(--cleanenv)
# The workspace is already present -- Apptainer mounts $PWD -- but be explicit,
# so this does not depend on where the caller happened to be standing.
ARGS+=(--pwd "$CALLER_PWD")
# And bind it, unless it is already inside a directory Apptainer mounts for us.
# $HOME and /tmp are automatic; anywhere else is not.
case "$CALLER_PWD" in
    "$HOME"/*|/tmp/*|"$HOME"|/tmp) ;;
    *) ARGS+=(-B "$CALLER_PWD:$CALLER_PWD") ;;
esac

while IFS=$'\t' read -r src dst mode; do
    [ -n "$src" ] || continue
    if [ "$mode" = "ro" ]; then ARGS+=(-B "$src:$dst:ro"); else ARGS+=(-B "$src:$dst"); fi
done < <(printf '%s' "$INSPECT" | python3 -c '
import json, sys
for m in json.load(sys.stdin)["mounts"]:
    print("%s\t%s\t%s" % (m["source"], m["target"], m["mode"]))')

while IFS=$'\t' read -r key value; do
    [ -n "$key" ] || continue
    ARGS+=(--env "$key=$value")
done < <(printf '%s' "$INSPECT" | python3 -c '
import json, sys
for k, v in sorted(json.load(sys.stdin)["env"].items()):
    print("%s\t%s" % (k, v))')

# The FLEXlm/libudev workaround is baked as ENV in the build stage of the image,
# so it survives the conversion and needs nothing here. --cleanenv does not
# remove the image environment, only the caller's.

hosts=$(printf '%s' "$INSPECT" | python3 -c \
    'import json,sys;print(" ".join(g["host"] for g in json.load(sys.stdin)["egress"]))')
# No policy to apply: the network is the host's, with no namespace. Say so once,
# rather than letting a reader assume the licence grant happened as under sbx.
[ -n "$hosts" ] && gecho "Licence server: $hosts (reached directly; there is no network policy here)"

set -- "${@:-}"
if [ "$#" -gt 0 ] && [ -n "$1" ]; then
    exec "$RUNTIME" exec "${ARGS[@]}" "$SIF" "$@"
fi
exec "$RUNTIME" shell "${ARGS[@]}" "$SIF"
