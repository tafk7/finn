# Stages: system -> python -> runtime -> dev -> sbx, and runtime -> release.
#
#   system   OS packages and the fixes Xilinx tools need. Changes rarely.
#   python   uv and /opt/venv with FINN's locked dependencies (uv.lock), always
#            active, and the redistributable external resources (finn-hlslib).
#            FINN itself is not installed: the entrypoint installs the mounted
#            checkout editable when a container starts.
#   runtime  accelerator userspace selected by FINN_RUNTIMES (XRT, SLASH).
#   dev      the runtime image plus third-party Vivado board files, which FINN
#            may not redistribute: for local images only. The default target.
#   sbx      the dev image plus the in-container privileges sbx needs.
#   release  the runtime image with a FINN wheel installed, for read-only use
#            (SIF/HPC); no checkout is needed. Board files are fetched on first
#            use.
#
# The image is x86-64 only (Vivado and XRT are).

# Must match the Ubuntu release the runtime manifests were built for; each
# manifest may declare EXPECT_OS, which docker/install-runtimes.sh checks.
ARG UBUNTU_TAG=noble-20240605


# --- system ------------------------------------------------------------------
FROM ubuntu:${UBUNTU_TAG} AS system
LABEL maintainer="Jakoba Petri-Koenig <jakoba.petri-koenig@amd.com>, Thomas Preusser <thomas.preusser@amd.com>"

# Some Vitis dependencies prompt for a timezone during installation.
ENV TZ="Europe/Dublin"
ARG DEBIAN_FRONTEND=noninteractive
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Recommends stay on: dropping them changes the Vivado/XRT runtime in ways that
# only a full synthesis run would show. python3-dev provides Python.h for the
# XSI extension build; python3-venv lets users and tests create further venvs;
# tcsh is required by LSF esub scripts (/bin/csh shebang).
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y \
    build-essential \
    ca-certificates \
    libc6-dev-i386 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libyaml-0-2 \
    libjsoncpp-dev \
    libxml2-dev \
    libzmq3-dev \
    libpixman-1-0 \
    nano \
    rsync \
    git \
    openssh-client \
    sshpass \
    wget \
    sudo \
    unzip \
    zip \
    locales \
    lsb-release \
    python3 \
    python3-dev \
    python3-venv \
    python-is-python3 \
    pybind11-dev \
    libfmt-dev \
    libboost-dev \
    libjansson-dev \
    libgetdata-dev \
    libncurses6 \
    g++-13 \
    cmake \
    tcsh \
    tini && \
    rm -rf /var/lib/apt/lists/*

# LSB loader. lmutil and several Xilinx tool wrappers request the interpreter
# /lib64/ld-lsb-x86-64.so.3; without it they fail with a misleading "No such file
# or directory". It is an alias for the normal loader.
RUN set -eu; \
    loader=$(ls /lib/*-linux-gnu/ld-linux-x86-64.so.2 2>/dev/null | head -1); \
    [ -n "$loader" ] || { echo "ERROR: no ld-linux-x86-64.so.2 found" >&2; exit 1; }; \
    mkdir -p /lib64; \
    ln -sf "$loader" /lib64/ld-lsb-x86-64.so.3; \
    test -e /lib64/ld-lsb-x86-64.so.3

RUN echo "StrictHostKeyChecking no" >> /etc/ssh/ssh_config
RUN locale-gen "en_US.UTF-8"
ENV LANG="en_US.UTF-8" \
    LC_ALL="en_US.UTF-8" \
    LANGUAGE="en_US:en"

# FLEXlm workaround. Licence checkout fingerprints the host through libudev and
# corrupts the heap doing it ("realloc(): invalid pointer"); preloading the system
# libudev avoids it. Set as image ENV so docker exec and sbx exec inherit it. The
# check fails the build if a new base moves the library.
RUN test -e /lib/x86_64-linux-gnu/libudev.so.1 || \
    { echo "ERROR: libudev.so.1 is not at the preloaded path; update LD_PRELOAD" >&2; exit 1; }
ENV LD_PRELOAD=/lib/x86_64-linux-gnu/libudev.so.1

# Vendor tool shims. docker exec and sbx exec do not run the entrypoint, so bare
# vendor commands (e.g. `vivado -version`) go through a shim early on PATH that
# applies the selected toolchain environment.
COPY docker/toolchain-shim /usr/local/lib/finn/toolchain-shim
COPY docker/finn-toolchain.sh /etc/finn-toolchain.sh
RUN set -eu; \
    chmod 755 /usr/local/lib/finn/toolchain-shim; \
    chmod 644 /etc/finn-toolchain.sh; \
    mkdir -p /usr/local/lib/finn/toolchain-bin; \
    for t in vivado vitis vitis_hls vitis-run v++ slashkit xelab xsim xvlog xsc lmutil xsct; do \
        ln -sf /usr/local/lib/finn/toolchain-shim /usr/local/lib/finn/toolchain-bin/"$t"; \
    done

# XILINX_LOCAL_USER_DATA=no lets several Vivado instances run at once
# (https://adaptivesupport.amd.com/s/article/63253). TORCH_HOME/HF_HOME are set by
# docker/run only when it mounts a cache.
ENV VIVADO_IP_CACHE="/tmp/vivado_ip_cache" \
    NUM_DEFAULT_WORKERS=4 \
    LOCALHOST_URL="localhost" \
    SHELL=/bin/bash \
    XILINX_LOCAL_USER_DATA=no

# A stable non-root default user. docker/run overrides it with --user $UID:$GID.
# The Ubuntu base ships an `ubuntu` user at uid 1000; `agent` takes its place.
RUN userdel --remove ubuntu 2>/dev/null || true; \
    useradd --create-home --uid 1000 --shell /bin/bash agent && \
    chmod 0755 /home/agent && \
    mkdir -p /home/agent/.local/bin /home/agent/.cache && \
    chown -R agent:agent /home/agent


# --- python ------------------------------------------------------------------
FROM system AS python

COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /uvx /usr/local/bin/

# /opt/venv is active for every process (docker exec and sbx exec included), not
# only for login shells. It uses the distro Python; uv never downloads one.
ENV VIRTUAL_ENV=/opt/venv \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:/usr/local/lib/finn/toolchain-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# FINN's locked dependencies. FINN itself is not installed here; the entrypoint
# installs it editable from the mounted checkout.
# The venv is writable by any user because containers run as the caller's uid and
# the entrypoint installs into it; each container's writable layer is its own.
RUN --mount=type=bind,source=pyproject.toml,target=/tmp/finn-lock/pyproject.toml \
    --mount=type=bind,source=uv.lock,target=/tmp/finn-lock/uv.lock \
    --mount=type=cache,target=/root/.cache/uv \
    uv venv --python /usr/bin/python3.12 /opt/venv && \
    cd /tmp/finn-lock && \
    uv sync --frozen --no-install-project && \
    chmod -R a+rwX /opt/venv

# Fail the build on an inconsistent environment. The pytest run is not redundant
# with the metadata check: a plugin import failure (as with jupyter/anyio) has no
# metadata conflict.
RUN test "$(uv pip list --format freeze | wc -l)" -gt 100 && \
    uv pip check && \
    python -c "import numpy, scipy, onnx, onnxruntime, torch, qonnx, brevitas" && \
    mkdir -p /tmp/pytest-probe && \
    printf 'def test_probe():\n    assert True\n' > /tmp/pytest-probe/test_probe.py && \
    (cd /tmp/pytest-probe && pytest -q -p no:cacheprovider >/dev/null) && \
    rm -rf /tmp/pytest-probe

# Redistributable external resources (finn-hlslib) in the read-only system cache,
# at the pins in finn/resources.toml. finn.resources uses only the standard
# library, so it runs from the mounted sources before FINN is installed.
RUN --mount=type=bind,source=src/finn/resources,target=/tmp/src/finn/resources \
    --mount=type=bind,source=src/finn/resources.toml,target=/tmp/src/finn/resources.toml \
    PYTHONPATH=/tmp/src python -B -m finn.resources fetch --all --redistributable-only \
        --dest /opt/finn/resources >/dev/null && \
    rm -f /opt/finn/resources/.*.lock
ENV FINN_RESOURCES_SYSTEM_CACHE=/opt/finn/resources

COPY docker/finn_entrypoint.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/finn_entrypoint.sh

# tini reaps zombies as PID 1. sbx runs this ENTRYPOINT with its own keep-alive
# command instead of CMD.
ENTRYPOINT ["/usr/bin/tini", "--", "finn_entrypoint.sh"]
CMD ["bash"]
USER agent


# --- runtime -----------------------------------------------------------------
# FINN_RUNTIMES names manifests in docker/runtimes/ (e.g. "xrt" or "xrt,slash");
# empty by default. Manifests and packages are bind-mounted, so an unselected
# runtime's package never lands in a layer. See docker/runtimes/README.md.
FROM python AS runtime
USER root
ARG FINN_RUNTIMES=""
ENV FINN_RUNTIMES=${FINN_RUNTIMES}
RUN --mount=type=bind,source=docker/runtimes,target=/tmp/runtimes \
    --mount=type=bind,source=docker/packages,target=/tmp/packages \
    --mount=type=bind,source=docker/install-runtimes.sh,target=/tmp/install-runtimes.sh \
    sh /tmp/install-runtimes.sh
USER agent


# --- dev ---------------------------------------------------------------------
# Third-party Vivado board files join the system cache. They may not be
# redistributed, so only images built locally contain them.
FROM runtime AS dev
USER root
RUN --mount=type=bind,source=src/finn/resources,target=/tmp/src/finn/resources \
    --mount=type=bind,source=src/finn/resources.toml,target=/tmp/src/finn/resources.toml \
    PYTHONPATH=/tmp/src python -B -m finn.resources fetch --kind vivado-boards \
        --dest /opt/finn/resources >/dev/null && \
    rm -f /opt/finn/resources/.*.lock
USER agent


# --- release -----------------------------------------------------------------
# FINN installed from a wheel built from this context. For
# read-only images (SIF/HPC): no checkout, no startup install.
FROM runtime AS release-wheels
USER root
ARG FINN_SOURCE_REVISION=unknown
ARG FINN_SOURCE_DIRTY=unknown
RUN --mount=type=bind,source=.,target=/tmp/context \
    cp -r /tmp/context /tmp/finn && \
    cd /tmp/finn && \
    python -c 'import json,os; from pathlib import Path; d=os.environ["FINN_SOURCE_DIRTY"]; Path("FINN_BUILD_INFO.json").write_text(json.dumps({"version": Path("VERSION").read_text().strip(), "revision": os.environ["FINN_SOURCE_REVISION"], "dirty": d == "1" if d in {"0", "1"} else None}))' && \
    uv build --wheel --no-build-isolation --out-dir /opt/finn/wheels .

FROM runtime AS release
USER root
RUN --mount=type=bind,from=release-wheels,source=/opt/finn/wheels,target=/tmp/wheels \
    uv pip install --no-deps /tmp/wheels/*.whl && \
    sha256sum /tmp/wheels/*.whl > /opt/finn/release-wheels.sha256 && \
    uv pip check
# The installed FINN is the one to use; do not replace it with a mounted checkout.
ENV FINN_SYNC=0
USER agent


# --- sbx ---------------------------------------------------------------------
# The image of FINN's sbx workload kit (finn.yaml at the repository root builds
# this stage). A separate target, not a build argument, so the in-container
# privilege model (NOPASSWD sudo) is visible. This is in-container root only:
# no devices, capabilities or privileged mode. No coding agent: a harness is a
# kit layered on at sandbox creation.
#
#   NOPASSWD sudo    kits run as `agent` and install software.
#   proxy env_keep   without it, commands under sudo lose the sandbox proxy.
#   home layout      kits and agents write into the agent's home (0755).
#   npm prefix       global npm installs land in a directory that is on PATH.
#   /etc/sandbox-persistent.sh
#                    sbx-managed; it must exist for BASH_ENV to source.
#   launch           sbx starts the agent with the image's command; the shell
#                    is the default. Setup runs as the workload's startup hook.
FROM dev AS sbx
USER root
COPY docker/finn-bashenv.sh /etc/finn-bashenv.sh
ENV BASH_ENV=/etc/finn-bashenv.sh \
    FINN_BUILD_DIR=/tmp/finn_build \
    NO_PROXY=localhost,127.0.0.1,::1,172.17.0.0/16 \
    no_proxy=localhost,127.0.0.1,::1,172.17.0.0/16 \
    NPM_CONFIG_PREFIX=/usr/local/share/npm-global \
    PATH=/home/agent/.local/bin:/usr/local/share/npm-global/bin:/opt/venv/bin:/usr/local/lib/finn/toolchain-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN set -eu; \
    usermod -aG sudo agent; \
    echo "agent ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/agent; \
    echo 'Defaults:%sudo env_keep += "http_proxy https_proxy ftp_proxy all_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY SSL_CERT_FILE NODE_EXTRA_CA_CERTS REQUESTS_CA_BUNDLE JAVA_TOOL_OPTIONS"' >> /etc/sudoers.d/agent; \
    chmod 0440 /etc/sudoers.d/agent; \
    mkdir -p /home/agent/.npm /home/agent/workspace /usr/local/share/npm-global/bin; \
    chown -R agent:agent /home/agent; \
    chmod -R a+rX /usr/local/share/npm-global; \
    touch /etc/sandbox-persistent.sh; \
    chmod 0644 /etc/sandbox-persistent.sh
USER agent
ENTRYPOINT ["bash"]
CMD ["-l"]
