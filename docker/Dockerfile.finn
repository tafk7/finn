# =============================================================================
# Three publishable targets, each a superset of the last:
#
#   system -> python -> dev        no XRT, no Xilinx, no build data   [agent]
#                        \-> build          + finn-hlslib, board files [RTL/HLS]
#                             \-> build-xrt + XRT, v80++               [Alveo/V80]
#
# `dev` is the sandboxed-agent image: it runs quicktest.sh, the non-Vivado
# pytest subset, linting and every import-level task, with the network closed
# and nothing mounted but the workspace. `build` adds the ~900 MB of HLS headers
# and board definitions that Vivado and Vitis HLS need. `build-xrt` adds XRT,
# which FINN reaches for only on Vitis/Alveo paths - notably NOT for rtlsim,
# which needs Vivado's xsim and never XRT.
#
# No image bakes an identity. Identity is a runtime concern: run-docker.sh
# passes --user, and any orchestrator that runs this image is expected to
# provision a passwd entry and drop privileges itself. A per-user image would
# also make the tag a lie, since the tag encodes only the git describe and the
# XRT version.
# =============================================================================

# Ubuntu base for every stage. For build-xrt this is not free to choose: it must
# match the OS the XRT package targets, so run-docker.sh derives it from
# XRT_DEB_VERSION and the build-xrt stage asserts the two agree.
#
# A date-pinned snapshot, not the rolling `ubuntu:jammy`. Canonical republishes
# the rolling tag regularly, which would let image contents drift under an
# unchanged FINN tag. run-docker.sh owns the codename -> snapshot mapping.
ARG UBUNTU_TAG=jammy-20230126


# --- system: OS packages, locale, timezone. Changes ~never. ------------------
FROM ubuntu:${UBUNTU_TAG} AS system
LABEL maintainer="Jakoba Petri-Koenig <jakoba.petri-koenig@amd.com>, Yaman Umuroglu <yaman.umuroglu@amd.com>"

# some Vitis deps require a timezone to be specified, which hangs in Docker
# use workaround from https://grigorkh.medium.com/fix-tzdata-hangs-docker-image-build-cdb52cc3360d
ENV TZ="Europe/Dublin"
# ARG, not ENV: this is a build-time concern and should not leak into the
# runtime environment of every container started from the image.
ARG DEBIAN_FRONTEND=noninteractive
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Recommends are left on deliberately. The size win in this redesign comes from
# the tier split, not from trimming the base OS, and --no-install-recommends
# here would be a behaviour change to the Vivado/XRT runtime that is difficult
# to validate without a full synthesis run.
#
# The ncurses 5 ABI is NOT in this list; it is handled separately below, because
# it does not exist on every supported release.
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y \
    build-essential \
    ca-certificates \
    libc6-dev-i386 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libyaml-0-2 \
    libjsoncpp-dev \
    libxml2-dev \
    libzmq3-dev \
    libpixman-1-0 \
    nano \
    rsync \
    git \
    openssh-client \
    sshpass \
    wget \
    sudo \
    unzip \
    zip \
    locales \
    lsb-release \
    python3 \
    python-is-python3 \
    python3-pip \
    python3-setuptools-scm \
    python3-venv \
    pybind11-dev \
    libfmt-dev \
    libboost-dev \
    libjansson-dev \
    libgetdata-dev \
    g++-10 \
    cmake \
    tcsh && \
    rm -rf /var/lib/apt/lists/*
# tcsh: required by LSF esub scripts (they ship with a /bin/csh shebang).

# ncurses 5 ABI, which Vivado links against.
#
# focal and jammy ship libtinfo5/libncurses5; noble dropped them for the
# ncurses 6 ABI. Rather than pin the package list to one release, ask apt what
# it has and backport the jammy packages when it has nothing - which is exactly
# the workaround used to run Vivado on a noble host, and is validated there.
#
# Checksummed because this is an unauthenticated fetch installed as root, and
# taken from the archive pool rather than a PPA so there is no third party in
# the trust path. ~200 KB for both.
ARG NCURSES5_VERSION=6.3-2ubuntu0.2
ARG LIBTINFO5_SHA256=b9bb64e716a7d9de05b1b33992763142ca81bcae3a7f8ce7e29fa3c6fd32f1e8
ARG LIBNCURSES5_SHA256=91d18fcc4165a40d27e8181eb282bcaf89c2a5e6c6dc182b37df33827407361c
RUN set -eu; \
    apt-get update; \
    if apt-cache show libtinfo5 2>/dev/null | grep -q '^Package:'; then \
        echo "ncurses 5 ABI available from the distro"; \
        apt-get install -y libtinfo5 libncurses5; \
    else \
        . /etc/os-release; \
        echo "ncurses 5 ABI absent on $VERSION_ID, backporting from the jammy pool"; \
        pool=http://archive.ubuntu.com/ubuntu/pool/universe/n/ncurses; \
        arch=$(dpkg --print-architecture); \
        wget -q "$pool/libtinfo5_${NCURSES5_VERSION}_${arch}.deb"   -O /tmp/libtinfo5.deb; \
        wget -q "$pool/libncurses5_${NCURSES5_VERSION}_${arch}.deb" -O /tmp/libncurses5.deb; \
        echo "$LIBTINFO5_SHA256  /tmp/libtinfo5.deb"     | sha256sum -c -; \
        echo "$LIBNCURSES5_SHA256  /tmp/libncurses5.deb" | sha256sum -c -; \
        apt-get install -y /tmp/libtinfo5.deb /tmp/libncurses5.deb; \
        rm -f /tmp/libtinfo5.deb /tmp/libncurses5.deb; \
    fi; \
    rm -rf /var/lib/apt/lists/*; \
    ldconfig; \
    test -e /usr/lib/$(uname -m)-linux-gnu/libtinfo.so.5 || \
        { echo "ERROR: libtinfo.so.5 missing after install" >&2; exit 1; }; \
    echo "ncurses 5 ABI present: $(readlink -f /usr/lib/$(uname -m)-linux-gnu/libtinfo.so.5)"

# LSB loader for Xilinx's LSB-linked binaries.
#
# lmutil and several tool wrappers request the interpreter
# /lib64/ld-lsb-x86-64.so.3. Without it they fail to exec with "No such file or
# directory" naming a file that plainly exists -- the classic missing-ELF-
# interpreter error, and a confusing one to chase.
#
# The original Dockerfile got this from `lsb-core`, which no longer exists on
# noble, so this image installs `lsb-release` (metadata only) and creates the
# loader symlink directly. It is only ever an alias for the normal loader.
# Note the naming mismatch that makes this fiddly: `uname -m` reports x86_64
# with an underscore, while the loader is ld-linux-x86-64.so.2 with a hyphen.
# Xilinx tooling is amd64-only, so this resolves the real loader by glob rather
# than by constructing the name.
RUN set -eu; \
    loader=$(ls /lib/*-linux-gnu/ld-linux-x86-64.so.2 2>/dev/null | head -1); \
    [ -n "$loader" ] || { echo "ERROR: no ld-linux-x86-64.so.2 found" >&2; exit 1; }; \
    mkdir -p /lib64; \
    ln -sf "$loader" /lib64/ld-lsb-x86-64.so.3; \
    test -e /lib64/ld-lsb-x86-64.so.3 || \
        { echo "ERROR: LSB loader symlink dangling; Xilinx lmutil will not exec" >&2; exit 1; }; \
    echo "LSB loader: $(readlink -f /lib64/ld-lsb-x86-64.so.3)"

RUN echo "StrictHostKeyChecking no" >> /etc/ssh/ssh_config
RUN locale-gen "en_US.UTF-8"

# Locale is set once, here, rather than re-exported by the entrypoint on every
# container start as it used to be.
ENV LANG="en_US.UTF-8" \
    LC_ALL="en_US.UTF-8" \
    LANGUAGE="en_US:en"

# PEP 668: noble and later mark the system Python externally managed, so a
# system-wide `pip install` refuses outright. That warning is aimed at a shared
# machine whose package manager owns site-packages - in a single-purpose,
# disposable container the Python environment IS the deliverable, so there is no
# system to protect and a venv would only add indirection.
#
# jammy has no EXTERNALLY-MANAGED marker and its pip 22.0.2 accepts the variable
# as a no-op, so this is inert on the currently validated base.
ENV PIP_BREAK_SYSTEM_PACKAGES=1


# --- python: the interpreter environment. Changes with requirements. ---------
FROM system AS python

# torch first and alone: it is the largest and most stable pin in the tree, so it
# belongs in a layer that edits to requirements.txt cannot invalidate.
#
# CPU build, not cu126. The CUDA wheels pull ~5 GB of nvidia/* and triton that
# nothing here can reach: FINN's src and tests contain no .cuda(), no
# torch.cuda, not even an is_available() guard, and run-docker.sh never passes
# --gpus (NVIDIA_VISIBLE_DEVICES is set and then unused), so no container can
# see a device in the first place. This removes dead weight, not capability.
#
# Restoring GPU support means adding the --gpus plumbing AND a separate
# cuda-variant image tag - not flipping this index back, which would only make
# every image 5 GB larger while remaining unable to reach a device.
RUN pip install --no-cache-dir \
    torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0 \
    --index-url https://download.pytorch.org/whl/cpu

# Dependency profile: which (Ubuntu, Python, pin set) combination to build.
#
#   py310  Ubuntu 22.04 / Python 3.10 - the currently validated configuration
#   py312  Ubuntu 24.04 / Python 3.12 - tracks upstream PR 1603
#
# The profile owns every Python pin plus the XRT package; run-docker.sh derives
# the Ubuntu release from that XRT package, so selecting a profile selects the
# whole stack coherently. See docker/profiles/README.md.
ARG FINN_PROFILE=py310

COPY requirements.txt /tmp/requirements.txt
COPY docker/profiles /tmp/profiles

# Cap what later layers may resolve to - per profile, because the bounds differ.
# See docker/profiles/README.md for why these are load-bearing rather than
# defensive.
RUN cp /tmp/profiles/$FINN_PROFILE/constraints.txt /etc/finn-pip-constraints.txt
ENV PIP_CONSTRAINT=/etc/finn-pip-constraints.txt

# Base FINN requirements, then the interaction and test stack. Grouped rather
# than one RUN per package: ~30 sequential layers cost cache granularity that
# was never used, since these pins move together in practice.
#
# The --ignore-installed sets are split by phase because the ordering genuinely
# differs by release, and getting it wrong is a hard failure rather than a
# nuisance:
#
#   pre   must precede the base requirements. noble ships typing_extensions as a
#         Debian package with no RECORD file, so pip cannot uninstall it and any
#         requirement wanting a newer one aborts the whole resolve.
#   post  must follow the tool set. jammy's jupyter and matplotlib fight
#         distro-provided copies, but installing them first would let the base
#         requirements resolve against the wrong versions.
#
# Either file may be absent; a profile declares only the phases it needs.
RUN set -eu; \
    p=/tmp/profiles/$FINN_PROFILE; \
    . $p/profile.env; \
    echo "Building profile $FINN_PROFILE: $FINN_PROFILE_DESC"; \
    if [ -s $p/tools-force-pre.txt ]; then \
        pip install --no-cache-dir --ignore-installed -r $p/tools-force-pre.txt; \
    fi; \
    pip install --no-cache-dir -r "$FINN_PROFILE_REQUIREMENTS"; \
    pip install --no-cache-dir -r $p/tools.txt; \
    if [ -s $p/tools-force-post.txt ]; then \
        pip install --no-cache-dir --ignore-installed -r $p/tools-force-post.txt; \
    fi

RUN pip install --no-cache-dir -e git+https://github.com/fbcotter/dataset_loading.git@0.0.4#egg=dataset_loading


# --- dev: FINN's dependency closure. The agent image. ------------------------
FROM python AS dev

# Pins come from deps.env, the same file fetch-repos.sh reads, so the commit
# baked here and the commit checked out on the host cannot drift apart. Each is
# overridable at build time exactly as it is at fetch time.
ARG QONNX_COMMIT
ARG FINN_EXP_COMMIT
ARG BREVITAS_COMMIT

COPY deps.env fetch-repos.sh /opt/finn-src/
# Fetch and install the three importable deps as ordinary wheels, then drop the
# checkouts - brevitas alone is 222 MB of git history that the image never needs.
#
# These wheels are not usually what gets imported: FINN_DEPS=live (the default)
# has the mounted workspace shadow them. Their job is to carry the dependency
# closure, the metadata and the 19 console scripts, so that a container can
# start with no network and no pip install.
RUN cd /opt/finn-src && \
    ./fetch-repos.sh python && \
    pip install --no-cache-dir \
        ./deps/qonnx \
        ./deps/finn-experimental \
        ./deps/brevitas && \
    rm -rf /opt/finn-src/deps

# Resolve FINN and, in live mode, the deps from the mounted workspace. Installed
# into site-packages so it applies to every interpreter start, including ones
# the entrypoint never sees (docker exec, Jupyter kernels, pytest workers).
COPY docker/finn_paths.py docker/finn-live.pth /tmp/finnpaths/
RUN SITE_PACKAGES=$(python -c 'import site; print(site.getsitepackages()[0])') && \
    install -m 644 /tmp/finnpaths/finn_paths.py "$SITE_PACKAGES/finn_paths.py" && \
    install -m 644 /tmp/finnpaths/finn-live.pth "$SITE_PACKAGES/finn-live.pth" && \
    rm -rf /tmp/finnpaths && \
    python -c 'import finn_paths' && \
    echo "finn_paths installed into $SITE_PACKAGES"

# Keep deps.env the single place a Python dependency is declared. finn_paths.py
# holds its own readable copy of the layout so it works outside the image; this
# asserts the two agree and fails the build if a dep is added to one and not the
# other, which would otherwise fail silently as an unresolvable import at run
# time in live mode.
RUN . /opt/finn-src/deps.env && \
    expected=$(for d in $FINN_DEP_GROUP_PYTHON; do \
        eval "dir=\$${d}_DIR"; echo "deps/$dir/src"; \
    done | sort | tr '\n' ' ') && \
    actual=$(python -c 'import finn_paths; print("\n".join(finn_paths.DEP_SRC_DIRS))' | sort | tr '\n' ' ') && \
    if [ "$expected" != "$actual" ]; then \
        echo "ERROR: finn_paths.DEP_SRC_DIRS is out of sync with deps.env" >&2; \
        echo "  deps.env expects: $expected" >&2; \
        echo "  finn_paths has  : $actual" >&2; \
        exit 1; \
    fi; \
    echo "finn_paths.DEP_SRC_DIRS agrees with deps.env: $actual"

# Fail the build on an inconsistent environment rather than shipping one. pip
# reports resolver conflicts as a warning and exits 0, so without this a layer
# that upgrades a pinned transitive dep produces a working-looking image whose
# ONNX runtime is broken.
#
# finnexperimental is deliberately absent from the import list. Its setup.cfg
# uses `packages = find:` over a namespace package with no __init__.py, so it
# finds zero packages and the wheel is metadata-only - it has only ever resolved
# through the path entry, never through the install. That is an upstream
# packaging bug, and harmless here: FINN imports finnexperimental nowhere, and
# the wheel still pulls deap/mip/networkx, which is the reason to install it.
RUN pip check && \
    python -c "import numpy, scipy, onnx, onnxruntime, torch, qonnx, brevitas, deap, mip, networkx; \
print('env consistent: numpy', numpy.__version__, '| torch', torch.__version__, '| onnxruntime', onnxruntime.__version__)" && \
    mkdir -p /tmp/pytest-probe && \
    printf 'def test_probe():\n    assert True\n' > /tmp/pytest-probe/test_probe.py && \
    (cd /tmp/pytest-probe && pytest -q >/dev/null) && \
    rm -rf /tmp/pytest-probe && \
    echo "pytest loads its plugins and runs a test cleanly"
# The pytest collection is not redundant with pip check. The jupyter/anyio/pytest
# incompatibility is a runtime import failure with no metadata conflict, so pip
# check passes while every pytest invocation dies at plugin load.

COPY docker/finn_entrypoint.sh docker/quicktest.sh docker/build_dataflow \
     docker/finn-env /usr/local/bin/
RUN chmod 755 /usr/local/bin/finn_entrypoint.sh \
              /usr/local/bin/quicktest.sh \
              /usr/local/bin/build_dataflow \
              /usr/local/bin/finn-env

# Transparent vendor-tool shims.
#
# Neither `docker exec` nor `sbx exec` runs the image ENTRYPOINT, so a bare
#
#     docker exec <container> vivado -version
#
# saw none of the toolchain environment. An explicit `finn-env exec` wrapper
# does not fix that: a generic agent or CI system issues the bare command and
# has no reason to know FINN's calling convention. The shim directory goes
# EARLY on PATH so the bare command works with no caller cooperation.
#
# The tool list comes from finn-env's SHIMMED_TOOLS, and the build asserts they
# agree -- so adding a tool in one place cannot silently skip the other.
COPY docker/toolchain-shim /usr/local/lib/finn/toolchain-shim
COPY docker/finn-bashenv.sh /etc/finn-bashenv.sh
RUN set -eu; \
    chmod 755 /usr/local/lib/finn/toolchain-shim; \
    chmod 644 /etc/finn-bashenv.sh; \
    mkdir -p /usr/local/lib/finn/toolchain-bin; \
    for t in $(python -c 'import runpy,sys; \
        m=runpy.run_path("/usr/local/bin/finn-env"); \
        print(" ".join(m["SHIMMED_TOOLS"]))'); do \
        ln -sf /usr/local/lib/finn/toolchain-shim \
               /usr/local/lib/finn/toolchain-bin/"$t"; \
    done; \
    echo "shimmed: $(ls /usr/local/lib/finn/toolchain-bin | tr '\n' ' ')"; \
    test -L /usr/local/lib/finn/toolchain-bin/vivado

# Static environment. Everything here used to be passed as -e on every docker
# run, which meant it could not reach a runtime with no create-time env
# injection seam - notably sbx, whose microVM create path has none. Only genuine
# host bindings
# (FINN_XILINX_PATH, VIVADO_PATH, FINN_BUILD_DIR, licences, ports) stay runtime.
ENV VIVADO_IP_CACHE="/tmp/vivado_ip_cache" \
    NUM_DEFAULT_WORKERS=4 \
    LOCALHOST_URL="localhost" \
    SHELL=/bin/bash \
    FINN_DEPS=live \
    XILINX_LOCAL_USER_DATA=no
# TORCH_HOME / HF_HOME are deliberately NOT set here, though §3.4 grouped them
# with the static tier. They point into /finn_cache, which exists only when
# FINN_DOCKER_CACHE_DIR is mounted; baking them would make torch.hub try to
# create /finn_cache as a non-root user and fail whenever the cache is absent.
# run-docker.sh sets them alongside the mount, and without it torch falls back
# to ~/.cache, which always works.
# XILINX_LOCAL_USER_DATA=no: workaround for running multiple Vivado instances
# simultaneously, see https://adaptivesupport.amd.com/s/article/63253
#
# LD_PRELOAD is a FlexLM workaround and is deliberately NOT set here. It only
# matters once a licensed Xilinx tool is in play, and setting it image-wide
# makes every unrelated process in the dev tier pay for it. The entrypoint sets
# it when it actually finds Xilinx tools to source.

# A non-root default identity, and PID 1 that reaps.
#
# These are generic good practice, not sbx-specific, so they belong in the
# image everyone uses. The parts of the sbx template contract that grant actual
# privilege -- NOPASSWD sudo above all -- live in the sbx-* targets at the
# bottom of this file, so that a tag says which privilege model you got.
#
#   agent uid 1000     a stable, non-root identity. run-docker.sh still
#                      overrides it with --user $UID:$GID.
#   /home/agent 0755   with .claude/.local/.npm/.cache/workspace present. A bare
#                      0750 home fails sbx kit install with "cannot create
#                      .../settings.json: Permission denied". That requirement
#                      is in no documentation; it came from diffing a stock
#                      template. Harmless here, and keeping the home layout in
#                      one place avoids a second chown -R in the sbx layer.
#   tini as PID 1      reaps zombies. Also what run-docker.sh's --init provided
#                      for Vivado, so that flag is now redundant.
RUN set -eu; \
    useradd --create-home --uid 1000 --shell /bin/bash agent 2>/dev/null || true; \
    chmod 0755 /home/agent; \
    mkdir -p /home/agent/.claude /home/agent/.local/bin /home/agent/.npm \
             /home/agent/.cache /home/agent/workspace; \
    chown -R agent:agent /home/agent; \
    if ! command -v tini >/dev/null; then \
        apt-get update && \
        apt-get install -y --no-install-recommends tini && \
        rm -rf /var/lib/apt/lists/*; \
    fi

#   NPM_CONFIG_PREFIX must be paired with its bin dir on PATH. Setting the
#   prefix alone relocates `npm install -g` somewhere unreachable, so installing
#   a CLI appears to succeed and then `command -v <cli>` fails with 127.
# BASH_ENV points at finn-bashenv.sh, NOT straight at /etc/sandbox-persistent.sh.
# That file is sbx-managed and must still be sourced -- finn-bashenv.sh sources
# it first, then adds the toolchain environment that shells would otherwise miss.
# Pointing BASH_ENV directly at the sbx file, as this used to, left `bash -c`
# sessions with no Xilinx tools.
#
# The shim directory is early on PATH but AFTER npm-global, so it shadows the
# mounted toolchain's own bin (which settings64.sh prepends at source time)
# without shadowing anything sbxc or a harness installs.
ENV NO_PROXY=localhost,127.0.0.1,::1,172.17.0.0/16 \
    no_proxy=localhost,127.0.0.1,::1,172.17.0.0/16 \
    BASH_ENV=/etc/finn-bashenv.sh \
    NPM_CONFIG_PREFIX=/usr/local/share/npm-global \
    PATH=/usr/local/share/npm-global/bin:/usr/local/lib/finn/toolchain-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN mkdir -p /usr/local/share/npm-global/bin && chmod -R a+rX /usr/local/share/npm-global

# tini is PID 1; finn_entrypoint.sh still runs and still execs the command.
#
# CMD stays `bash` - the interactive default a bare `docker run -it` expects.
#
# sbx does NOT use this CMD: it runs the image ENTRYPOINT but substitutes its
# own keep-alive command, so PID 1 in a sandbox reads
#
#   /usr/bin/tini -- finn_entrypoint.sh sh -c 'trap ...; sleep infinity & wait'
#
# An earlier revision set CMD to `sleep infinity` believing a bash with no TTY
# was what killed the sandbox. It was not - the entrypoint's fatal "no FINN
# source" check was, because sbx starts PID 1 with cwd=/. That check is now a
# warning, and CMD is irrelevant to sbx either way.
ENTRYPOINT ["/usr/bin/tini", "--", "finn_entrypoint.sh"]
CMD ["bash"]

# The image's default user. This was missing entirely: `agent` was created but
# never selected, so every consumer that did not pass --user got ROOT. That
# included plain `docker run`, `docker exec`, and any orchestrator reading the
# image's own metadata to decide who to run as.
#
# run-docker.sh still passes --user $UID:$GID and so is unaffected; this fixes
# the default for everyone who does not.
#
# Stages below re-assert USER root for their install steps and restore this at
# the end. A stage that forgets will fail loudly on the first apt-get, which is
# the desired failure mode.
USER agent


# --- build: + the non-Python build data. Vivado / Vitis HLS flows. -----------
FROM dev AS build
USER root

ARG HLSLIB_COMMIT
ARG AVNET_BDF_COMMIT
ARG XIL_BDF_COMMIT
ARG RFSOC4x2_BDF_COMMIT
ARG KV260_BDF_COMMIT
ARG AUPZU3_BDF_COMMIT

# HLS C++ headers and Vivado board definitions. Never imported, reached through
# FINN_HLSLIB_PATH / FINN_BOARD_FILES_PATH from generated Tcl and g++ include
# flags. Baking them here is what lets the dev tier - and every agent sandbox -
# skip ~900 MB it has no way to use.
# deps.env and fetch-repos.sh are already in place from the dev stage.
RUN cd /opt/finn-src && \
    ./fetch-repos.sh data && \
    rm -rf /opt/finn-src/deps/*/.git

ENV FINN_HLSLIB_PATH=/opt/finn-src/deps/finn-hlslib \
    FINN_BOARD_FILES_PATH=/opt/finn-src/deps/board_files

USER agent


# --- build-xrt: + XRT and v80++. Vitis / Alveo / V80 targets only. -----------
FROM build AS build-xrt
USER root

# One authored value. The Ubuntu release and the target architecture are derived
# from it rather than pinned separately, because a Noble package on a Jammy base
# is something apt will generally resolve rather than refuse - yielding a subtly
# wrong runtime instead of a clean failure.
#
#   xrt_202420.2.18.179_24.04-amd64-xrt
#       └ version ──┘ └ OS ┘ └arch┘
#
ARG XRT_DEB_VERSION="xrt_202220.2.14.354_22.04-amd64-xrt"
ARG XRT_DEB_SHA256=""
ARG SKIP_XRT
ARG LOCAL_XRT
ARG V80PP_DEB_PACKAGE
ARG TARGETARCH

# Bracket glob so a missing local .deb is not an error: this is only present
# when run-docker.sh staged one from FINN_XRT_PATH (the LOCAL_XRT path).
COPY ${XRT_DEB_VERSION}.de[b] /tmp/

# Make the §2.8 mismatch unrepresentable: fail the build rather than produce an
# image whose XRT targets an OS or architecture it is not running on.
RUN set -eu; \
    if [ -n "${SKIP_XRT:-}" ]; then echo "SKIP_XRT set, skipping XRT consistency check"; exit 0; fi; \
    deb_os=$(echo "$XRT_DEB_VERSION" | sed -n 's/.*_\([0-9][0-9]\.[0-9][0-9]\)-.*/\1/p'); \
    deb_arch=$(echo "$XRT_DEB_VERSION" | sed -n 's/.*-\([a-z0-9]*\)-xrt$/\1/p'); \
    run_os=$(. /etc/os-release; echo "$VERSION_ID"); \
    if [ -z "$deb_os" ] || [ -z "$deb_arch" ]; then \
        echo "ERROR: cannot parse XRT_DEB_VERSION='$XRT_DEB_VERSION'" >&2; \
        echo "       expected xrt_<version>_<os>-<arch>-xrt" >&2; exit 1; \
    fi; \
    if [ "$deb_os" != "$run_os" ]; then \
        echo "ERROR: XRT package targets Ubuntu $deb_os but this image is Ubuntu $run_os" >&2; \
        echo "       XRT_DEB_VERSION=$XRT_DEB_VERSION" >&2; \
        echo "       The base image is derived from XRT_DEB_VERSION; do not set" >&2; \
        echo "       UBUNTU_CODENAME by hand." >&2; exit 1; \
    fi; \
    if [ -n "${TARGETARCH:-}" ] && [ "$deb_arch" != "$TARGETARCH" ]; then \
        echo "ERROR: XRT package targets $deb_arch but the build platform is $TARGETARCH" >&2; \
        exit 1; \
    fi; \
    echo "XRT $XRT_DEB_VERSION consistent with Ubuntu $run_os/${TARGETARCH:-unknown}"

# Prefer download.amd.com, which serves current releases, but fall back to the
# older openDownload redirect. Not belt-and-braces: the currently pinned
# 2022.2-era package 404s on download.amd.com and is only available from the
# legacy endpoint, so switching unconditionally would break this tier outright.
#
# The spoofed browser user-agent the previous revision sent is dropped - the
# endpoint serves a plain wget fine, so it was cargo cult.
#
# Verify a checksum when one is supplied: this is an unauthenticated fetch of a
# package installed as root, so an unpinned download is a supply-chain soft spot.
# run-docker.sh passes FINN_XRT_SHA256 through when it is set.
RUN set -eu; \
    if [ -n "${LOCAL_XRT:-}" ] || [ -n "${SKIP_XRT:-}" ]; then exit 0; fi; \
    out=/tmp/$XRT_DEB_VERSION.deb; \
    if ! wget -q "https://download.amd.com/opendownload/xrt/$XRT_DEB_VERSION.deb" -O "$out"; then \
        echo "download.amd.com has no $XRT_DEB_VERSION, falling back to openDownload" >&2; \
        rm -f "$out"; \
        wget -q "https://www.xilinx.com/bin/public/openDownload?filename=$XRT_DEB_VERSION.deb" -O "$out"; \
    fi; \
    if [ -n "$XRT_DEB_SHA256" ]; then \
        echo "$XRT_DEB_SHA256  $out" | sha256sum -c - ; \
    else \
        echo "WARNING: XRT downloaded without checksum verification." >&2; \
        echo "         Set FINN_XRT_SHA256 to pin it. sha256 of this download:" >&2; \
        sha256sum "$out" >&2; \
    fi

RUN set -eu; \
    if [ -n "${SKIP_XRT:-}" ]; then exit 0; fi; \
    apt-get update && \
    apt-get install -y --no-install-recommends /tmp/$XRT_DEB_VERSION.deb && \
    rm -f /tmp/$XRT_DEB_VERSION.deb && \
    rm -rf /var/lib/apt/lists/*

# Install v80++. If the package isn't provided, this is a no-op.
# The wildcard pattern ensures COPY doesn't fail if the file doesn't exist.
COPY v80pp.de[b] /tmp/
RUN if [ -f /tmp/v80pp.deb ]; then \
        apt-get update && \
        apt-get install -y --no-install-recommends /tmp/v80pp.deb && \
        rm /tmp/v80pp.deb && \
        rm -rf /var/lib/apt/lists/*; \
    fi

USER agent


# =============================================================================
# sbx targets: the generic image plus the privileged half of the sbx template
# contract.
#
# WHY SEPARATE TARGETS AND NOT A BUILD ARGUMENT
# ---------------------------------------------
# NOPASSWD sudo is a real capability. Gating it behind a build argument would
# produce two images with materially different privilege that are
# indistinguishable by tag -- a hidden variant. A named target puts the
# privilege model in the tag, where anything reading the image can see it.
#
# WHY NOT A SEPARATE DOCKERFILE
# -----------------------------
# Inheritance ENFORCES behavioural equivalence with the generic image; a second
# Dockerfile only hopes for it. BuildKit shares every lower layer, so the
# marginal cost of these targets is one thin layer each, not a second image.
# Duplicated paths drifting is exactly the failure that produced the mount
# defects this redesign started from -- adding a second axis of duplication
# would be the wrong lesson to draw.
#
# WHAT SBX NEEDS THAT THE GENERIC IMAGE DELIBERATELY WITHHOLDS
# ------------------------------------------------------------
#   NOPASSWD sudo    sbx kits run as `agent` and install software.
#   proxy env_keep   Ubuntu ships these commented out. Without them anything
#                    the agent runs under sudo silently loses its proxy config
#                    and its network calls fail looking like an egress denial.
#   /etc/sandbox-persistent.sh
#                    sbx-managed; the image must never WRITE it, but the file
#                    has to exist for BASH_ENV to source on the first shell.
#   NPM_CONFIG_PREFIX
#                    for harnesses that `npm install -g`. Paired with its bin
#                    dir on PATH already, in the generic ENV -- setting the
#                    prefix alone puts the binary somewhere unreachable and the
#                    install appears to succeed, then `command -v` fails 127.
#
# In-container root here is NOT a violation of the dev tier's "no privileges"
# contract, which is about HOST exposure: no devices, no added capabilities, no
# privileged mode, no sensitive writable mounts. The conformance suite asserts
# both readings separately.
#
# Reverse-engineered from bisecting real create failures, therefore breakable
# by an sbx release. Verified by creating a sandbox with plain `sbx`, no
# wrapper.
# =============================================================================

FROM dev AS sbx-dev
USER root
COPY docker/sbx-contract.sh /tmp/sbx-contract.sh
RUN sh /tmp/sbx-contract.sh && rm -f /tmp/sbx-contract.sh
USER agent

FROM build AS sbx-build
USER root
COPY docker/sbx-contract.sh /tmp/sbx-contract.sh
RUN sh /tmp/sbx-contract.sh && rm -f /tmp/sbx-contract.sh
USER agent

FROM build-xrt AS sbx-build-xrt
USER root
COPY docker/sbx-contract.sh /tmp/sbx-contract.sh
RUN sh /tmp/sbx-contract.sh && rm -f /tmp/sbx-contract.sh
USER agent
