# Ubuntu 24.04 / Python 3.12 - tracks upstream PR 1603
# (Xilinx/finn branch upgrade/python_version), which is WIP at time of writing.
#
# The Ubuntu release is NOT set here: run-docker.sh derives it from
# XRT_DEB_VERSION so the two cannot disagree. A 24.04 package selects noble,
# which is where Python 3.12 comes from.
FINN_PROFILE_DESC="Ubuntu 24.04 / Python 3.12 (tracks upstream PR 1603)"
FINN_PROFILE_XRT="xrt_202420.2.18.179_24.04-amd64-xrt"
# Not yet pinned: this package has not been fetched and checksummed here. The
# build prints the observed sha256 so it can be filled in.
FINN_PROFILE_XRT_SHA256=""
# This profile carries its own base requirements, taken from the upstream branch.
FINN_PROFILE_REQUIREMENTS="/tmp/profiles/py312/requirements.txt"
