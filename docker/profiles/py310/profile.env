# Ubuntu 22.04 / Python 3.10 - the currently validated configuration.
#
# The Ubuntu release is NOT set here: run-docker.sh derives it from
# XRT_DEB_VERSION so the two cannot disagree. A 22.04 package selects jammy,
# which is where Python 3.10 comes from.
FINN_PROFILE_DESC="Ubuntu 22.04 / Python 3.10 (current)"
FINN_PROFILE_XRT="xrt_202220.2.14.354_22.04-amd64-xrt"
FINN_PROFILE_XRT_SHA256="00f62fbf3e3b4972df96eb0a73191765f9a004c9cf86df9dff70450b32ccdbe0"
# Base FINN requirements. Points at the repo-root file so the profile in active
# use has no duplicate to drift from.
FINN_PROFILE_REQUIREMENTS="/tmp/requirements.txt"
