#!/usr/bin/env bash
# Compatibility entry point. Prefer: ./docker/run --backend apptainer

set -euo pipefail
DIR=$(dirname "$(readlink -f "$0")")
args=(--backend apptainer)
case "${1:-}" in
    -h|--help) exec "$DIR/run" --help ;;
    rm) shift; args+=(--remove) ;;
    build) shift; args+=(--fpga) ;;
    build-xrt) shift; args+=(--fpga --runtime xrt) ;;
    dev) shift ;;
esac
[ "${1:-}" = "--" ] && shift
exec "$DIR/run" "${args[@]}" -- "$@"
