#!/usr/bin/env python3
# Copyright (C) 2026, Advanced Micro Devices, Inc.
# SPDX-License-Identifier: BSD-3-Clause
"""Run a command in FINN's container, as a native shell would run it.

    docker/run [--fpga | --no-tools] [--runtime NAME] [--release] [--notebook]
               [--build | --no-build] [--dry-run] [--hostname NAME] [-v SRC:DST]
               [-e VAR[=VALUE]] [-- COMMAND...]
    docker/run --explain-extra

The container is compose.yaml's: this checkout and the working directory, FINN_HOME
and the build directory are mounted at their host paths, and the container runs as
the caller. AMD tools follow the shell, as natively: with XILINX_VIVADO set (a
sourced settings64.sh, a site module, or a CI job's environment), compose.tools.yaml
mounts the install root read-only and the container sources that release's
settings64.sh. Without it, a job's FINN_XILINX_PATH and FINN_XILINX_VERSION
(run-docker.sh's variables) do the same: the container finds the release under the
install root. --fpga requires the tools; --no-tools leaves them out.

The image is built with `docker buildx bake` when it is missing (--build rebuilds
it): finn:dev, finn:dev-<runtime> with --runtime (xrt, slash), finn:release with
--release (FINN from its wheel). COMPOSE_FILE adds further Compose files.

Without Docker Compose (Ubuntu's docker.io has none), and whenever FINN_DOCKER_EXTRA
(a site's extra `docker run` arguments, run-docker.sh's variable) is set, the same
container starts with plain `docker run`, FINN_DOCKER_EXTRA appended as given
(docker/plain_run.py); COMPOSE_FILE then cannot apply, so docker/run refuses it.
--explain-extra says which way it starts, without FINN_DOCKER_EXTRA's values.
"""
import argparse
import importlib.util
import os
import plain_run
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]


def fail(message):
    sys.exit(f"docker/run: {message}")


def finn_paths():
    """finn.util.paths, from the checkout: FINN is not installed on the host."""
    spec = importlib.util.spec_from_file_location("finn_paths", REPO / "src/finn/util/paths.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def host_paths(variable):
    """The absolute paths in a colon-separated variable (licence files, platform
    repositories); port@host licence servers need no mount."""
    return [
        p for p in os.environ.get(variable, "").split(":") if p.startswith("/") and Path(p).exists()
    ]


def parse_args(argv):
    """docker/run's options, and the command to run in the container."""
    parser = argparse.ArgumentParser(prog="docker/run", description=__doc__.split("\n\n")[0])
    tools = parser.add_mutually_exclusive_group()
    tools.add_argument("--fpga", action="store_true", help="require the AMD tools")
    tools.add_argument("--no-tools", action="store_true", help="leave the AMD tools out")
    parser.add_argument("--runtime", action="append", default=[], help="image with this runtime")
    parser.add_argument(
        "--release", action="store_true", help="FINN from its wheel, not the checkout"
    )
    parser.add_argument("--notebook", action="store_true", help="start Jupyter on JUPYTER_PORT")
    build = parser.add_mutually_exclusive_group()
    build.add_argument("--build", action="store_true", help="rebuild the image first")
    build.add_argument("--no-build", action="store_true", help="never build the image")
    parser.add_argument("--dry-run", action="store_true", help="print the command, run nothing")
    parser.add_argument(
        "--explain-extra",
        action="store_true",
        help="say how the container starts, without FINN_DOCKER_EXTRA's values; run nothing",
    )
    parser.add_argument("--hostname", default="", help="the container's host name")
    parser.add_argument("-v", "--volume", action="append", default=[], help="an extra mount")
    parser.add_argument("-e", "--env", action="append", default=[], help="an extra variable")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if args.notebook and command:
        fail("--notebook takes no command")
    return args, command


def amd_tools(args, env):
    """The Compose files and mounts that bring the shell's AMD tools in, if any."""
    vivado = None if args.no_tools else os.environ.get("XILINX_VIVADO")
    install = None if args.no_tools else job_install_root()
    if not vivado and not install:
        if args.fpga:
            fail(
                "--fpga needs the AMD tools, but XILINX_VIVADO is not set. Source a release's "
                "settings64.sh (or load the site's Vivado module) first."
            )
        return [], []
    if vivado:
        # <root>/<release>/Vivado and <root>/Vivado/<release> alike: two levels up.
        selected = Path(vivado).absolute().parents[1]
        root = Path(vivado).resolve().parents[1]
    else:
        # docker/profile.sh finds the release under it, in either layout.
        selected = install.absolute()
        root = install.resolve()
    # The container needs the tree at its canonical path, which AMD's settings scripts
    # may name, and also as the variable names it, when a symlink selects the release.
    env["FINN_XILINX_ROOT"] = str(root)
    volumes = [] if selected == root else [f"{selected}:{selected}:ro"]
    for variable in ("XILINXD_LICENSE_FILE", "LM_LICENSE_FILE", "PLATFORM_REPO_PATHS"):
        volumes += [f"{path}:{path}:ro" for path in host_paths(variable)]
    override = os.environ.get("FINN_TOOL_DIR_OVERRIDE")
    if override:
        volumes.append(f"{override}:{override}:ro")
    return [REPO / "compose.tools.yaml"], volumes


def job_install_root():
    """The install root a job names with FINN_XILINX_PATH and FINN_XILINX_VERSION, if
    both are set."""
    path, version = (os.environ.get(v) for v in ("FINN_XILINX_PATH", "FINN_XILINX_VERSION"))
    if not (path and version):
        return None
    if not Path(path).is_dir():
        fail(f"FINN_XILINX_PATH={path} is not a directory")
    return Path(path)


def has_compose():
    """Whether `docker compose` is installed."""
    return (
        bool(shutil.which("docker"))
        and not subprocess.run(["docker", "compose", "version"], capture_output=True).returncode
    )


def main(argv=None):
    args, command = parse_args(argv)
    value = os.environ.get(plain_run.VARIABLE, "")
    try:
        if args.explain_extra:
            print(plain_run.explain(value, has_compose()))
            return
        extra = plain_run.split(value)
    except plain_run.PlainRunError as error:
        fail(str(error))
    runtimes = sorted({r for value in args.runtime for r in value.split(",") if r})
    suffix = "".join("-" + r for r in runtimes)
    image = (
        os.environ.get("FINN_IMAGE") or ("finn:release" if args.release else "finn:dev") + suffix
    )
    paths = finn_paths()
    env = {
        "FINN_IMAGE": image,
        "FINN_UID": str(os.getuid()),
        "FINN_GID": str(os.getgid()),
        "FINN_ROOT": str(REPO),
        "FINN_WORKDIR": os.getcwd(),
        "FINN_HOME": str(paths.home().absolute()),
        "FINN_BUILD_DIR": str(paths.scratch()),
    }
    if args.hostname:
        env["FINN_HOSTNAME"] = args.hostname
    # ensure build dir exists locally
    for directory in (env["FINN_HOME"], env["FINN_BUILD_DIR"]):
        os.makedirs(directory, exist_ok=True)
    volumes = list(args.volume)
    if not Path(os.getcwd()).resolve().is_relative_to(REPO):
        volumes.append(f"{os.getcwd()}:{os.getcwd()}")
    # A worktree's git directory lies outside the checkout: mount it, so that git and the
    # version from git (setuptools-scm) work in the container too.
    volumes += [f"{path}:{path}" for path in git_dirs_outside(REPO)]
    if (REPO / "ssh_keys").is_dir():
        volumes.append(f"{REPO / 'ssh_keys'}:/run/finn/ssh:ro")

    tool_files, tool_volumes = amd_tools(args, env)
    volumes += tool_volumes
    service = "notebook" if args.notebook else "finn"
    compose_files = [f for f in os.environ.get("COMPOSE_FILE", "").split(os.pathsep) if f]

    if extra or not has_compose():
        # Plain docker run, from the same definition (docker/plain_run.py).
        why = f"{plain_run.VARIABLE} is set" if extra else "docker compose is not installed"
        if compose_files:
            fail(
                f"COMPOSE_FILE needs docker compose, and docker/run starts the container "
                f"with plain `docker run` ({why}); pass its settings as docker/run's "
                f"--hostname, --volume and --env, or in {plain_run.VARIABLE}"
            )
        try:
            definition = plain_run.definition(
                {**os.environ, **env}, service, tools=bool(tool_files)
            )
            argv = plain_run.docker_run(
                definition, extra, volumes, args.env, command, sys.stdin.isatty()
            )
        except plain_run.PlainRunError as error:
            fail(str(error))
    else:
        env["COMPOSE_FILE"] = os.pathsep.join(
            map(str, [REPO / "compose.yaml", *tool_files, *compose_files])
        )
        argv = ["docker", "compose", "--progress", "quiet", "--project-directory", str(REPO)]
        argv += ["run", "--rm", "--pull", "never"]
        if args.notebook:
            argv.append("--service-ports")
        # Drop the pseudo-TTY when stdin is not a terminal (e.g. Jenkins), so that the run
        # does not fail with "the input device is not a TTY".
        if not sys.stdin.isatty():
            argv.append("-T")
        for volume in volumes:
            argv += ["--volume", volume]
        for variable in args.env:
            argv += ["--env", variable]
        argv += [service, *command]

    bake = ["docker", "buildx", "bake", "--load", "release" if args.release else "finn"]
    bake_env = {"FINN_RUNTIMES": ",".join(runtimes)}
    if args.dry_run:
        for key, value in env.items():
            print(f"{key}={shlex.quote(value)}")
        print(shlex.join(argv))
        return
    if not shutil.which("docker"):
        fail("docker is not installed")
    missing = subprocess.run(["docker", "image", "inspect", image], capture_output=True).returncode
    if args.build or (missing and not args.no_build):
        bake_env["FINN_VERSION"] = finn_version()
        subprocess.run(bake, cwd=REPO, env={**os.environ, **bake_env}, check=True)
    elif missing:
        fail(f"there is no image {image}: build it with docker/run --build, or drop --no-build")
    os.execvpe("docker", argv, {**os.environ, **env})


def git_dirs_outside(repo):
    """The checkout's git directories that lie outside it (a worktree's), if git is at hand."""
    if not shutil.which("git"):
        return []
    found = subprocess.run(
        ["git", "rev-parse", "--absolute-git-dir", "--git-common-dir"],
        cwd=repo,
        capture_output=True,
        text=True,
    )
    if found.returncode != 0:
        return []
    paths = {(repo / line).resolve() for line in found.stdout.splitlines()}
    return sorted(str(p) for p in paths if not p.is_relative_to(repo.resolve()))


def finn_version():
    """The checkout's version for the release image, if setuptools-scm is at hand."""
    for python in (REPO / ".venv" / "bin" / "python", Path(sys.executable)):
        if python.exists():
            found = subprocess.run(
                [str(python), "-m", "setuptools_scm"], cwd=REPO, capture_output=True, text=True
            )
            if found.returncode == 0 and found.stdout.strip():
                return found.stdout.strip().splitlines()[-1]
    return ""


if __name__ == "__main__":
    main()
