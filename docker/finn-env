#!/usr/bin/env python3
"""FINN's single host-fact resolver.

    finn-env inspect --format json|sh   Emits the mounts, egress grants,
                                        environment and policy a launcher needs.

HOST SIDE ONLY
--------------
This program runs before launch and answers "what does this machine have".
Applying the toolchain INSIDE a container is docker/finn-toolchain.sh, a
sourceable shell file with no Python in it.

That split is new. This file used to carry both, through `finn-env print` and
`finn-env exec`, which spawned Python (85 ms) to spawn a bash to source the
settings scripts and diff the result against an allowlist -- 124 ms to avoid
7 ms of sourcing, with a cache to avoid the 124 ms. Measured, not assumed. The
container side is now 7 ms of shell.

The layout probe stays HERE, and only here: finn-toolchain.sh is handed
XILINX_VIVADO and friends as process environment and probes nothing. One
resolver, still.

WHY ONE RESOLVER
----------------
The host view and the container view must agree about the same facts - where the
toolchain is, which licence form is in use, what the workspace path is. When
those were derived twice, they drifted, and the drift was silent:

  - the docker path mounted the whole Xilinx root; the sbx path mounted
    $ROOT/$VERSION, which is the post-2024.2 layout only, so on a 2022.2 site
    the sandbox got no toolchain at all while still being handed VIVADO_PATH;
  - PLATFORM_REPO_PATHS was passed to sbx as env with no corresponding mount;
  - the Xilinx root was :ro on one path and :rw on the other.

Three bugs, one cause. Deriving each fact exactly once is the fix, and this
file is where "once" is.

WHY A RESOLVER AND NOT GENERATED FILES
--------------------------------------
An alternative was to generate compose.yaml / the sbx kit / bake args from one
source. Rejected: generated files go stale silently when someone edits the
output instead of the input. This runs at launch, so it cannot disagree with
itself. Compose consumes its output through a generated .env, which is a cache
with a single producer, not a second source of truth.

STDOUT IS DATA
--------------
`inspect` and `print` emit machine-readable output on stdout and nothing else.
Every diagnostic goes to stderr. Callers may pipe stdout directly.
"""

import argparse
import json
import os
import re
import sys

# A tier is a GRANT profile, not an image. There is one image; what differs
# between these two is what the launcher mounts and allows.
#
# `build-xrt` used to be a third tier. It differed from `build` by one mount,
# and its real content -- XRT -- is now a runtime target baked into the image
# and named in its tag. See docker/runtimes/README.md.
TIERS = ("dev", "build")

# Tiers that get a toolchain, a licence and toolchain egress. `dev` deliberately
# gets none of it: that boundary is the reason the tier exists, and it is
# enforced here rather than left to whether the caller's shell happens to have
# FINN_XILINX_PATH set.
#
# This is now the ONLY place the boundary is drawn. It used to be drawn twice --
# here, and again by which image you pulled -- and the two could disagree.
FPGA_TIERS = ("build",)


def runtime_tag(runtimes=None):
    """The tag suffix for a set of runtime targets: 'xrt,slash' -> '.slash.xrt'.

    Sorted, so the tag is a function of the SET. Unsorted, `xrt,slash` and
    `slash,xrt` would name the same image twice. Must agree with tag() in
    docker-bake.hcl; there is a conformance test that they do.
    """
    if runtimes is None:
        runtimes = os.environ.get("FINN_RUNTIMES", "")
    names = sorted(n for n in runtimes.replace(",", " ").split() if n)
    return "".join("." + n for n in names)

# D4: the workspace path policy.
#
#   mirror  container path == host path. Required for anything that generates
#           Vivado projects, because add_files writes $::env(FINN_ROOT) into the
#           .xpr as an absolute path (LIMITATION(finn-root-absolute)), so a
#           project built under a fixed path cannot be opened in the host GUI.
#           Also forced by sbx, which has no mount remapping.
#   fixed   container path == FIXED_WORKSPACE. Better for remote daemons,
#           reproducible diagnostics and Dev Container config.
#
# dev defaults to "fixed" and the FPGA tiers to "mirror". dev is Python-only and
# generates no Vivado projects, so mirroring buys it nothing while costing
# remote-daemon support, reproducible diagnostic paths, and simple Dev Container
# config. The FPGA tiers generate projects and so must mirror.
#
# CONSEQUENCE: FINN_ROOT differs between dev and the FPGA tiers on one host, so
# the workspace path moves when you switch tiers. finn_paths.py resolves either
# correctly, but it surprises people; it is called out in compose.yaml and the
# docs for that reason.
FIXED_WORKSPACE = "/workspace/finn"
DEFAULT_DEV_WORKSPACE_POLICY = "fixed"

# Vendor executables that get a transparent shim (stage 3). Listed here because
# the shim needs the same toolchain resolution this file already performs.
SHIMMED_TOOLS = ("vivado", "vitis", "vitis_hls", "vitis-run", "v++",
                 "xelab", "xsim", "xvlog", "xsc", "lmutil", "xsct")

def warn(msg):
    print("finn-env: %s" % msg, file=sys.stderr)


def die(msg, code=1):
    print("finn-env: error: %s" % msg, file=sys.stderr)
    sys.exit(code)


# --------------------------------------------------------------------------
# Shared resolution. Used by both the host and container sides.
# --------------------------------------------------------------------------

def hostpath(value):
    """Expand `~` and make a host path absolute.

    Necessary because a tilde only expands in a shell, unquoted, at the start of
    a word. It never expands from inside a variable, and Docker Compose never
    expands one in an env file. So `FINN_HOST_BUILD_DIR=~/builds` in the
    environment becomes a bind mount whose target is a directory literally named
    `~`, created in whatever the working directory is.

    This is not hypothetical. This repository contains a stray `~/builds/`
    directory of HLS output from 2026-07-22, and `.gitignore`'s `*~` rule --
    which is there for editor backups -- hides it from `git status`.

    Applied to every path this program emits, because those paths become mount
    arguments.
    """
    if not value:
        return value
    return os.path.abspath(os.path.expanduser(value))


def xilinx_layout(root, version):
    """Locate Vivado / Vitis / HLS within a Xilinx install.

    AMD reorganised the install tree after 2024.2:

        <= 2024.2   $ROOT/Vivado/2022.2   $ROOT/Vitis_HLS/2022.2
        >  2024.2   $ROOT/2025.1/Vivado   $ROOT/2025.1/Vitis

    Returning both candidates and probing is deliberate. Deciding from the
    version string alone means a site with a symlinked or non-standard tree gets
    a confidently wrong answer; probing means an unusual layout is detected
    rather than assumed. The version string only orders the candidates.
    """
    if not root or not version:
        return {}

    m = re.match(r"^(20\d\d)\.([12])$", version)
    if not m:
        warn("FINN_XILINX_VERSION %r is not YYYY.1 or YYYY.2; "
             "probing both layouts anyway" % version)
        new_first = False
    else:
        new_first = (int(m.group(1)), int(m.group(2))) > (2024, 2)

    new = {
        "XILINX_VIVADO": os.path.join(root, version, "Vivado"),
        "XILINX_VITIS": os.path.join(root, version, "Vitis"),
        "XILINX_HLS": os.path.join(root, version, "Vitis"),
    }
    old = {
        "XILINX_VIVADO": os.path.join(root, "Vivado", version),
        "XILINX_VITIS": os.path.join(root, "Vitis", version),
        "XILINX_HLS": os.path.join(root, "Vitis_HLS", version),
    }

    found = {}
    for candidate in ((new, old) if new_first else (old, new)):
        for key, path in candidate.items():
            if key not in found and os.path.isdir(path):
                found[key] = path
    return found


def vendor_daemon_port(files):
    """The pinned FLEXlm vendor-daemon port, if the site pinned one.

    FLEXlm needs TWO connections. lmgrd on the advertised port is a directory
    service; it hands back a second port where the vendor daemon (xilinxd) does
    the actual checkout. That second port is EPHEMERAL by default, which is why
    the egress grant defaults to the whole host.

    It does not have to be ephemeral. A licence admin can pin it:

        DAEMON xilinxd /opt/xilinx/xilinxd port=2101

    When we can see a licence file, read it. When we cannot -- a bare PORT@HOST
    tells us nothing about the DAEMON line -- FINN_LICENSE_VENDOR_PORT lets the
    user state it.

    Returns None when unknown, and None means "grant the host", not "guess".
    """
    explicit = os.environ.get("FINN_LICENSE_VENDOR_PORT", "").strip()
    if explicit:
        if not explicit.isdigit():
            warn("FINN_LICENSE_VENDOR_PORT=%r is not a port number; ignoring"
                 % explicit)
        else:
            return explicit

    for path in files or ():
        try:
            with open(hostpath(path), "r", errors="replace") as handle:
                text = handle.read()
        except OSError:
            continue
        m = re.search(r"^\s*DAEMON\s+\S+.*?\bport\s*=\s*(\d+)", text,
                      re.IGNORECASE | re.MULTILINE)
        if m:
            return m.group(1)
    return None


def classify_license(value):
    """Split a FLEXlm licence variable into server and file entries.

    XILINXD_LICENSE_FILE / LM_LICENSE_FILE take a colon-separated list of
    either form:

        PORT@HOST     floating server. Nothing to mount; needs TCP egress.
        /path/to.lic  node-locked file. Must be readable inside the container.

    Egress defaults to the whole HOST, because the vendor-daemon port is
    ephemeral unless the site pinned it -- see vendor_daemon_port(). A
    port-scoped rule against an unpinned daemon lets `lmutil lmstat` succeed,
    because lmstat only talks to lmgrd, while every real checkout fails with
    "A valid license was not found" -- a thoroughly misleading error for a
    firewall problem.

    So: narrow ONLY when the vendor port is known, and say so out loud when you
    do. lmstat is not a test of the narrowed rule.
    """
    servers, files = [], []
    for entry in (value or "").split(":"):
        entry = entry.strip()
        if not entry:
            continue
        if "@" in entry:
            port, _, host = entry.partition("@")
            servers.append({"host": host, "advertised_port": port})
        else:
            files.append(entry)
    return servers, files


def resolve_tier(tier):
    """Resolve `auto` to a real tier, here rather than in every launcher.

    `auto` means "build if this machine has a toolchain, dev if it does not".
    That degrade used to live in run-docker.sh, which made it a fact derived in
    a launcher -- the exact shape of the four defects this program exists to
    prevent. It belongs here, once.

    `dev` and `build` stay EXPLICIT requests. An explicit `--tier build` with no
    toolchain is still a hard error: that is a request, not a default, and
    silently handing back a narrower environment than the caller asked for is
    how a CI shard ends up passing without testing anything.
    """
    if tier != "auto":
        return tier
    root = hostpath(os.environ.get("FINN_XILINX_PATH"))
    if root and os.path.isdir(root):
        return "build"
    warn("no FINN_XILINX_PATH; resolving --tier auto to 'dev'. "
         "Vivado, Vitis, HLS and rtlsim will be unavailable.")
    return "dev"


def resolve_host(tier, backend):
    """Everything a launcher needs, derived from the host, exactly once."""
    tier = resolve_tier(tier)
    if tier not in TIERS:
        die("unknown tier %r; expected one of %s" % (tier, ", ".join(TIERS)), 2)

    workspace_host = hostpath(os.environ.get(
        "FINN_ROOT",
        os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))

    # sbx and Apptainer both attach every mount at its host path and offer no
    # remapping, so the policy is not a free choice on either. Apptainer goes
    # further and mounts $PWD and $HOME automatically. Getting this wrong is not
    # subtle: a fixed FINN_ROOT under Apptainer points at a directory that was
    # never mounted, and `import finn` fails with ModuleNotFoundError.
    if backend in ("sbx", "apptainer") or tier in FPGA_TIERS:
        policy = "mirror"
    else:
        policy = DEFAULT_DEV_WORKSPACE_POLICY
    workspace_target = (workspace_host if policy == "mirror"
                        else FIXED_WORKSPACE)

    out = {
        "tier": tier,
        "backend": backend,
        # Which accelerator stacks the image is expected to carry. A launcher
        # passes this to bake as FINN_RUNTIMES and uses runtime_tag to name the
        # image, so one resolver decides both.
        "runtimes": sorted(n for n in os.environ.get("FINN_RUNTIMES", "")
                           .replace(",", " ").split() if n),
        "runtime_tag": runtime_tag(),
        "platform": "linux/amd64",
        "workspace": {
            "policy": policy,
            "source": workspace_host,
            "target": workspace_target,
        },
        "mounts": [],
        "egress": [],
        # Is the egress list ENFORCED, or merely declared?
        #
        # Only sbx enforces it: it has a policy engine, and `sbx policy allow
        # network` is what opens each grant. Docker containers have full
        # outbound network by default and compose adds no restriction, and
        # Apptainer uses the host's network namespace outright.
        #
        # This field exists because the dev tier used to report
        # `egress: false` on every backend, which was measurably untrue -- a
        # `docker run` of the dev image reaches pypi.org. Reporting a property
        # you do not enforce is worse than not claiming it, because a reader
        # cannot tell the difference and the conformance suite was asserting
        # the claim rather than the behaviour.
        "egress_enforcement": "enforced" if backend == "sbx" else "declared",
        "env": {"FINN_ROOT": workspace_target},
    }

    # `frozen`, matching finn_paths.DEFAULT_DEPS_MODE and every other site
    # (compose, run-docker.sh, finn-sbx, the Dockerfile, devcontainer.json).
    #
    # This said "auto" until it was caught by review. Because the documented way
    # to make a .env is `finn-env inspect --format sh > .env`, and because that
    # value then OVERRIDES ${FINN_DEPS:-frozen} in every compose service, the
    # single source of truth was quietly turning off the determinism it exists
    # to provide. The design record argues at length that auto-under-a-
    # deterministic-name is the worst combination; this reproduced it.
    deps = os.environ.get("FINN_DEPS", "frozen").lower()
    out["env"]["FINN_DEPS"] = deps

    if tier == "dev":
        # Asserted, not merely omitted. Something reading this output should be
        # able to see that the empty lists are a property of the tier rather
        # than a resolution that came up short.
        out["dev_contract"] = {
            "toolchain": False, "license": False, "egress": False,
        }
        return out

    root = hostpath(os.environ.get("FINN_XILINX_PATH"))
    version = os.environ.get("FINN_XILINX_VERSION")
    if not root:
        die("FINN_XILINX_PATH is unset; tier %r requires it" % tier, 3)
    if not os.path.isdir(root):
        die("FINN_XILINX_PATH=%s is not a directory" % root, 3)

    # The ROOT, read-only, on every backend.
    #
    # Mounting the root rather than $ROOT/$VERSION sidesteps the layout question
    # entirely -- which is what the docker path always did and what the sbx path
    # got wrong. It exposes more filesystem surface; read-only is what makes
    # that acceptable, and the tools do not write into their own installation.
    out["mounts"].append({"source": root, "target": root, "mode": "ro",
                          "reason": "xilinx-toolchain"})

    layout = xilinx_layout(root, version)
    if not layout:
        warn("no Vivado/Vitis/HLS found under %s for version %r; "
             "the toolchain mount will be present but empty of known tools"
             % (root, version))
    out["env"].update(layout)
    # Legacy aliases. FINN's own code and generated Tcl read these.
    if "XILINX_VIVADO" in layout:
        out["env"]["VIVADO_PATH"] = layout["XILINX_VIVADO"]
    if "XILINX_VITIS" in layout:
        out["env"]["VITIS_PATH"] = layout["XILINX_VITIS"]
    if "XILINX_HLS" in layout:
        out["env"]["HLS_PATH"] = layout["XILINX_HLS"]

    platforms = hostpath(os.environ.get("PLATFORM_REPO_PATHS"))
    if platforms and os.path.isdir(platforms):
        # Skip when the root mount already covers it, so a launcher does not
        # emit an overlapping bind.
        if not os.path.abspath(platforms).startswith(os.path.abspath(root) + os.sep):
            out["mounts"].append({"source": platforms, "target": platforms,
                                  "mode": "ro", "reason": "platform-repo"})
        out["env"]["PLATFORM_REPO_PATHS"] = platforms

    for var in ("XILINXD_LICENSE_FILE", "LM_LICENSE_FILE"):
        value = os.environ.get(var)
        if not value:
            continue
        out["env"][var] = value
        servers, files = classify_license(value)
        # Narrow to two ports when the vendor daemon's port is known, and to
        # the whole host when it is not. See vendor_daemon_port(). `ports: []`
        # means host-wide; a launcher must treat it as "no port restriction",
        # not as "no ports".
        vendor = vendor_daemon_port(files)
        for server in servers:
            grant = {"host": server["host"], "reason": "flexlm",
                     "advertised_port": server["advertised_port"],
                     "ports": []}
            if vendor:
                grant["ports"] = sorted({server["advertised_port"], vendor})
                grant["vendor_port"] = vendor
            out["egress"].append(grant)
        for path in files:
            directory = os.path.dirname(hostpath(path))
            if not os.path.isdir(directory):
                warn("licence path %s not found on the host; not mounted" % path)
                continue
            # The directory rather than the file: a single-file bind cannot
            # accommodate sibling state files. See the UNRESOLVED note in
            # docker/finn.kit/spec.yaml about :ro versus those writes.
            if not any(m["source"] == directory for m in out["mounts"]):
                out["mounts"].append({"source": directory, "target": directory,
                                      "mode": "ro", "reason": "license-file"})

    for var in ("NUM_DEFAULT_WORKERS", "IMAGENET_VAL_PATH"):
        if os.environ.get(var):
            out["env"][var] = os.environ[var]

    return out


def shquote(value):
    """Single-quote a value so it survives `eval`.

    cmd_print has always done this; cmd_inspect did not, and three callers
    eval its output -- finn-sbx, setup-local.sh and conformance.sh. A Xilinx
    path containing a space therefore truncated silently:

        $ eval "$(finn-env inspect --format sh | sed 's/^/export /')"
        bash: export: `Xilinx/2025.1/Vivado': not a valid identifier
        XILINX_VIVADO=[/tmp/My]

    A half-set toolchain, no error the caller checks. It was also an injection
    path: XILINXD_LICENSE_FILE passes through verbatim and is then eval'd, so a
    backtick in it ran on the host.

    One quoted format serves both consumers. Verified against compose 5.3.1:
    `--env-file` strips surrounding single quotes, so PLAIN=/a b/c and
    QUOTED='/a b/c' both resolve to the same value.
    """
    return "'" + str(value).replace("'", "'\\''") + "'"


def cmd_inspect(args):
    data = resolve_host(args.tier, args.backend)
    if args.format == "json":
        json.dump(data, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
    else:  # sh -- a .env file for Compose
        for key, value in sorted(data["env"].items()):
            sys.stdout.write("%s=%s\n" % (key, shquote(value)))
        sys.stdout.write("FINN_WORKSPACE_SOURCE=%s\n" % shquote(data["workspace"]["source"]))
        sys.stdout.write("FINN_WORKSPACE_TARGET=%s\n" % shquote(data["workspace"]["target"]))
        # Compose cannot get these from the shell: bash marks UID readonly and
        # exports neither, so ${UID} in a compose file silently resolves to its
        # default and every file written to a bind mount ends up owned by uid
        # 1000 instead of the invoking user.
        sys.stdout.write("FINN_UID=%d\n" % os.getuid())
        sys.stdout.write("FINN_GID=%d\n" % os.getgid())

        # The build directory, resolved AND created.
        #
        # Creating it is a side effect in a resolver, which is not free, but the
        # alternative is worse: Docker creates a missing bind source itself, as
        # ROOT. The container then runs as the invoking user and cannot write
        # it. That is not hypothetical -- adding a build-dir mount to the dev
        # service without this turned a green suite into 319 PermissionErrors,
        # and run-docker.sh already carries a comment warning about exactly this
        # for the torch/HF cache.
        #
        # Per-uid by default so two users on one host do not collide.
        build_dir = hostpath(os.environ.get(
            "FINN_HOST_BUILD_DIR", "/tmp/finn_build_%d" % os.getuid()))
        try:
            os.makedirs(build_dir, exist_ok=True)
        except OSError as exc:
            warn("could not create the build directory %s (%s)" % (build_dir, exc))
        sys.stdout.write("FINN_HOST_BUILD_DIR=%s\n" % shquote(build_dir))
        # Path-valued, so expand. FINN_PROFILE is a name, so it is not.
        #
        # FINN_XILINX_PATH is emitted only for the tiers that may have a
        # toolchain. It used to be emitted unconditionally, so a
        # `--tier dev` .env carried the host's Xilinx path -- breaking the dev
        # contract in the ONE output format compose actually reads. The JSON
        # output was always correct, which is why conformance test 2 passed:
        # it checks JSON.
        path_keys = []
        if data["tier"] in FPGA_TIERS:
            path_keys.append("FINN_XILINX_PATH")
        for key in path_keys:
            if os.environ.get(key):
                sys.stdout.write("%s=%s\n" % (key, shquote(hostpath(os.environ[key]))))
        # The image name's runtime suffix, so compose names the same image the
        # launchers and bake do. Empty for the base image, which is the default.
        sys.stdout.write("FINN_RUNTIME_TAG=%s\n" % shquote(data["runtime_tag"]))
    return 0


def main():
    parser = argparse.ArgumentParser(
        prog="finn-env", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("inspect", help="host-side resolution (JSON)")
    # `auto` degrades to dev when the host has no toolchain; dev and build are
    # explicit requests and an impossible one is an error. See resolve_tier().
    p.add_argument("--tier", default=os.environ.get("FINN_DOCKER_TARGET", "auto"),
                   choices=TIERS + ("auto",))
    p.add_argument("--backend", default="docker",
                   choices=("docker", "sbx", "apptainer"))
    p.add_argument("--format", default="json", choices=("json", "sh"))
    p.set_defaults(func=cmd_inspect)

    args = parser.parse_args()
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
