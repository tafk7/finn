{#
FINN Modern RTL Generator Template - MatrixVectorActivation Wrapper
Operation-specific template for MVAU RTL wrapper with enhanced Jinja2 features
#}
/*
 * Generated RTL wrapper for {{ node_name }}
 * Operation: {{ op_type }}
 * Generated by FINN Unified Code Generation Framework
 */

`timescale 1ns / 1ps

module {{ module_name }} #(
    // Module parameters
    {% for param in parameters %}
    parameter {{ param.type }} {{ param.name }} = {{ param.value }}{% if not loop.last %},{% endif %} // {{ param.description }}
    {% endfor %}
) (
    // Clock and reset
    input wire ap_clk,
    input wire ap_rst_n,
    
    // Input AXI4-Stream interface
    {% for port in input_ports %}
    {% if 'TDATA' in port.name or 'TVALID' in port.name or 'TREADY' in port.name %}
    {{ port.direction | format_port(port.width, port.name) }}, // {{ port.description }}
    {% endif %}
    {% endfor %}
    
    // Output AXI4-Stream interface  
    {% for port in output_ports %}
    {{ port.direction | format_port(port.width, port.name) }}{% if not loop.last %},{% endif %} // {{ port.description }}
    {% endfor %}
    
    {% if control_ports %}
    // Control interface
    {% for port in control_ports %}
    {{ port.direction | format_port(port.width, port.name) }}{% if not loop.last %},{% endif %} // {{ port.description }}
    {% endfor %}
    {% endif %}
);

    // Local parameters
    {% for lparam in localparam %}
    localparam {{ lparam.name }} = {{ lparam.value }}; // {{ lparam.description }}
    {% endfor %}
    
    // Internal signals
    logic [1:0] state, next_state;
    
    {% for width_name, width_val in data_widths.items() %}
    localparam {{ width_name | upper }} = {{ width_val }};
    {% endfor %}
    
    // FIFO interface signals
    {% for fifo_name, fifo_depth in fifo_depths.items() %}
    logic {{ fifo_name }}_full, {{ fifo_name }}_empty;
    logic {{ fifo_name }}_write_en, {{ fifo_name }}_read_en;
    {% endfor %}
    
    // Processing element signals
    {% if operation_config.use_weights %}
    logic [MW-1:0][MH-1:0][{{ data_widths.input_0_width }}-1:0] weight_memory;
    {% endif %}
    
    {% if parameters | selectattr('name', 'equalto', 'PE') | list | length > 0 %}
    {% set pe_count = (parameters | selectattr('name', 'equalto', 'PE') | first).value %}
    logic [PE-1:0][{{ data_widths.output_0_width }}-1:0] pe_results;
    logic [PE-1:0] pe_valid;
    {% endif %}

    // State machine
    always_ff @(posedge ap_clk) begin
        if (!ap_rst_n) begin
            state <= IDLE;
        end else begin
            state <= next_state;
        end
    end
    
    always_comb begin
        next_state = state;
        case (state)
            IDLE: begin
                if (in0_V_TVALID && out_V_TREADY) begin
                    next_state = PROCESSING;
                end
            end
            PROCESSING: begin
                // Processing logic
                if (processing_done) begin
                    next_state = DONE;
                end
            end
            DONE: begin
                next_state = IDLE;
            end
            default: next_state = IDLE;
        endcase
    end
    
    // Input handling
    assign in0_V_TREADY = (state == IDLE || state == PROCESSING) && !input_fifo_full;
    
    // Processing core instantiation
    {% if operation_config.use_weights %}
    {{ node_name }}_core #(
        .MW(MW),
        .MH(MH),
        .PE(PE),
        .SIMD(SIMD),
        .INPUT_WIDTH({{ data_widths.input_0_width }}),
        .OUTPUT_WIDTH({{ data_widths.output_0_width }})
    ) processing_core (
        .clk(ap_clk),
        .rst_n(ap_rst_n),
        .input_data(in0_V_TDATA),
        .input_valid(in0_V_TVALID && (state == PROCESSING)),
        .weights(weight_memory),
        .output_data(pe_results),
        .output_valid(pe_valid)
    );
    {% else %}
    // Generic processing core for operations without weights
    {{ node_name }}_core #(
        .DATA_WIDTH({{ data_widths.input_0_width }}),
        .OUTPUT_WIDTH({{ data_widths.output_0_width }})
    ) processing_core (
        .clk(ap_clk),  
        .rst_n(ap_rst_n),
        .input_data(in0_V_TDATA),
        .input_valid(in0_V_TVALID && (state == PROCESSING)),
        .output_data(out_V_TDATA),
        .output_valid(out_V_TVALID)
    );
    {% endif %}
    
    // Output handling
    {% if operation_config.use_weights %}
    // Multiplex PE outputs
    logic [$clog2(PE)-1:0] output_pe_select;
    logic output_counter_en;
    
    always_ff @(posedge ap_clk) begin
        if (!ap_rst_n) begin
            output_pe_select <= 0;
        end else if (output_counter_en) begin
            if (output_pe_select == PE-1) begin
                output_pe_select <= 0;
            end else begin
                output_pe_select <= output_pe_select + 1;
            end
        end
    end
    
    assign out_V_TDATA = pe_results[output_pe_select];
    assign out_V_TVALID = pe_valid[output_pe_select] && (state == PROCESSING || state == DONE);
    assign output_counter_en = out_V_TVALID && out_V_TREADY;
    {% else %}
    assign out_V_TREADY = 1'b1; // Always ready to receive output
    {% endif %}
    
    // Performance monitoring (optional)
    {% if code_variants.use_performance_counters %}
    logic [31:0] cycle_counter;
    logic [31:0] processing_cycles;
    
    always_ff @(posedge ap_clk) begin
        if (!ap_rst_n) begin
            cycle_counter <= 0;
            processing_cycles <= 0;
        end else begin
            cycle_counter <= cycle_counter + 1;
            if (state == PROCESSING) begin
                processing_cycles <= processing_cycles + 1;
            end
        end
    end
    {% endif %}
    
    // Assertions for verification
    {% if code_variants.use_assertions %}
    // Check AXI4-Stream protocol compliance
    assert property (@(posedge ap_clk) disable iff (!ap_rst_n)
        (in0_V_TVALID && !in0_V_TREADY) |=> in0_V_TVALID)
        else $error("AXI4-Stream input protocol violation");
        
    assert property (@(posedge ap_clk) disable iff (!ap_rst_n)
        (out_V_TVALID && !out_V_TREADY) |=> out_V_TVALID)
        else $error("AXI4-Stream output protocol violation");
    {% endif %}

endmodule

{% if code_variants.generate_testbench %}
// Testbench wrapper
`ifdef FINN_TESTBENCH
module {{ module_name }}_tb;
    
    // Testbench signals
    logic ap_clk = 0;
    logic ap_rst_n = 0;
    
    // Generate clock
    always #5 ap_clk = ~ap_clk;
    
    // DUT instantiation
    {{ module_name }} #(
        {% for param in parameters %}
        .{{ param.name }}({{ param.value }}){% if not loop.last %},{% endif %}
        {% endfor %}
    ) dut (
        .ap_clk(ap_clk),
        .ap_rst_n(ap_rst_n),
        // Connect other signals...
    );
    
    // Test sequence
    initial begin
        // Reset sequence
        ap_rst_n = 0;
        repeat(10) @(posedge ap_clk);
        ap_rst_n = 1;
        
        // Test cases
        // ... testbench implementation ...
        
        $finish;
    end

endmodule
`endif
{% endif %}