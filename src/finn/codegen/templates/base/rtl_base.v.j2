{#- Base RTL template that consolidates 80% of common Verilog code -#}
{% from "components/rtl/signal_declarations.j2" import io_signals, multi_io_signals, processing_signals, memory_signals, counter_signals, state_machine_signals %}
{% from "components/rtl/process_blocks.j2" import clk_rst_process, state_machine_comb, counter_process, pipeline_stage, handshake_logic, output_assignment %}
{% from "components/includes/operation_specific.j2" import operation_includes %}

{#- File header with operation info -#}
// {{ operation_name }} RTL Implementation
// Generated by FINN Clean Codegen Architecture
// Node: {{ node_name }}
// 
// Operation Parameters:
{% for key, value in operation_params.items() %}
// {{ key }}: {{ value }}
{% endfor %}

{#- Module declaration with standard I/O -#}
module {{ module_name }} (
{% if multi_input %}
    {{ multi_io_signals(input_widths, output_widths) }}
{% else %}
    {{ io_signals(input_width, output_width) }}
{% endif %}
);

{#- Operation-specific includes and parameters -#}
{{ operation_includes(operation_name, backend="rtl") }}

{#- Local parameters derived from operation -#}
{% if local_params %}
{% for param_name, param_value in local_params.items() %}
localparam {{ param_name }} = {{ param_value }};
{% endfor %}
{% endif %}

{#- Signal declarations based on operation type -#}
{% if has_processing_elements %}
{{ processing_signals(data_width, pe_count) }}
{% endif %}

{% if has_memory %}
{{ memory_signals(addr_width, data_width, mem_name) }}
{% endif %}

{% if has_counters %}
{{ counter_signals(counter_width, "cnt") }}
{% endif %}

{% if has_state_machine %}
{{ state_machine_signals(state_width, "state") }}
{% endif %}

{#- Memory initialization if needed -#}
{% if memory_init %}
initial begin
{% for init_line in memory_init %}
    {{ init_line }}
{% endfor %}
end
{% endif %}

{#- Main state machine -#}
{% if has_state_machine %}
{{ clk_rst_process("state", "IDLE") }}

{{ state_machine_comb("state", state_list) }}
{% endif %}

{#- Counter processes -#}
{% if has_counters %}
{{ counter_process("cnt", "MAX_COUNT") }}
{% endif %}

{#- Data processing pipeline -#}
{% if has_pipeline %}
{% for stage in pipeline_stages %}
{{ pipeline_stage("stage_" + loop.index0|string, stage.input, stage.output, stage.valid_in, stage.valid_out, stage.ready_in, stage.ready_out) }}
{% endfor %}
{% endif %}

{#- Memory access logic -#}
{% if has_memory %}
// Memory read logic
always @(posedge clk) begin
    if (rst) begin
        {{ mem_name }}_addr <= 0;
        {{ mem_name }}_we <= 1'b0;
    end else begin
        // Memory access logic here
    end
end
{% endif %}

{#- Handshake and output logic -#}
{{ handshake_logic() }}

{% if custom_output_logic %}
{{ custom_output_logic }}
{% else %}
{{ output_assignment() }}
{% endif %}

{#- Operation-specific processing logic -#}
{% block operation_logic %}
// Operation-specific logic goes here
// This block should be overridden by specific operation templates
{% endblock %}

{#- Custom logic insertion point -#}
{% if custom_logic %}
{{ custom_logic }}
{% endif %}

endmodule

{#- Submodule instantiations if needed -#}
{% if submodules %}
{% for submodule in submodules %}

module {{ submodule.name }} (
{{ submodule.ports }}
);
{{ submodule.implementation }}
endmodule
{% endfor %}
{% endif %}