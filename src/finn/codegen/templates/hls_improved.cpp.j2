    // Load test data
    std::ifstream input_file("{{ test_input_file }}");
    std::ifstream expected_file("{{ test_expected_file }}");
    
    // Run test
    {{ function_name }}(test_in, test_out);
    
    // Verify results
    int errors = 0;
    // ... verification code ...
    
    return errors;
}
#endif
{% endif %}