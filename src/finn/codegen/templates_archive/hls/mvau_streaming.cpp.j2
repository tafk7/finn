FINN Modern HLS Generator Template - MatrixVectorActivation Streaming
Operation-specific template for MVAU with streaming memory mode
#}
/*
 * Generated HLS code for {{ node_name }}
 * Operation: {{ op_type }}
 * Generated by FINN Unified Code Generation Framework
 */

// Required includes
{% for include in includes %}
{%- if include.endswith('.h') or include.endswith('.hpp') %}
#include "{{ include }}"
{%- else %}
#include <{{ include }}>
{%- endif %}
{% endfor %}

// Operation defines
{% for define_name, define_value in defines %}
{{ define_value | format_define(define_name) }}
{% endfor %}

// Function signature
void {{ function_name }}(
    {%- for i in range(input_shapes|length) %}
    hls::stream<{{ data_types['input_' ~ i ~ '_type'] }}> &in{{ i }}_V,
    {%- endfor %}
    hls::stream<{{ data_types['output_0_type'] }}> &out_V
    {%- if operation_params.mem_mode == "external" %},
    const {{ data_types['weight_type'] }} weights[MW][MH]
    {%- endif %}
) {
    
    // HLS pragmas
    {% for pragma in pragmas %}
    {{ pragma }}
    {% endfor %}
    
    // Local variables
    {% if operation_params.PE > 1 %}
    {{ data_types['output_0_type'] }} pe_outputs[PE];
    #pragma HLS ARRAY_PARTITION variable=pe_outputs complete
    {% endif %}
    
    {% if operation_params.SIMD > 1 %}
    {{ data_types['input_0_type'] }} simd_inputs[SIMD];
    #pragma HLS ARRAY_PARTITION variable=simd_inputs complete
    {% endif %}
    
    // Main processing loop
    MAIN_LOOP: for (int sample = 0; sample < {{ input_shapes[0][0] }}; sample++) {
        #pragma HLS PIPELINE II=1
        
        // Read input vector
        {% if operation_params.SIMD > 1 %}
        SIMD_INPUT_LOOP: for (int s = 0; s < SIMD; s++) {
            #pragma HLS UNROLL
            simd_inputs[s] = in0_V.read();
        }
        {% else %}
        {{ data_types['input_0_type'] }} input_val = in0_V.read();
        {% endif %}
        
        // Parallel processing elements
        {% if operation_params.PE > 1 %}
        PE_LOOP: for (int pe = 0; pe < PE; pe++) {
            #pragma HLS UNROLL
            
            // Compute dot product for this PE
            {{ data_types['acc_type'] }} acc = 0;
            
            DOT_PRODUCT_LOOP: for (int mw = 0; mw < MW/SIMD; mw++) {
                #pragma HLS PIPELINE II=1
                
                {% if operation_params.SIMD > 1 %}
                SIMD_COMPUTE_LOOP: for (int s = 0; s < SIMD; s++) {
                    #pragma HLS UNROLL
                    acc += simd_inputs[s] * weights[pe][mw*SIMD + s];
                }
                {% else %}
                acc += input_val * weights[pe][mw];
                {% endif %}
            }
            
            // Apply activation if specified
            {% if operation_params.ActType %}
            pe_outputs[pe] = apply_activation<{{ operation_params.ActType }}>(acc);
            {% else %}
            pe_outputs[pe] = acc;
            {% endif %}
        }
        
        // Write PE outputs
        PE_OUTPUT_LOOP: for (int pe = 0; pe < PE; pe++) {
            #pragma HLS PIPELINE II=1
            out_V.write(pe_outputs[pe]);
        }
        {% else %}
        // Single PE implementation
        {{ data_types['acc_type'] }} acc = 0;
        
        DOT_PRODUCT_LOOP: for (int mw = 0; mw < MW; mw++) {
            #pragma HLS PIPELINE II=1
            acc += input_val * weights[0][mw];
        }
        
        // Apply activation if specified
        {% if operation_params.ActType %}
        {{ data_types['output_0_type'] }} result = apply_activation<{{ operation_params.ActType }}>(acc);
        {% else %}
        {{ data_types['output_0_type'] }} result = acc;
        {% endif %}
        
        out_V.write(result);
        {% endif %}
    }
}

