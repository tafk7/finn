{#- Standard RTL process blocks that appear in 75% of operations -#}

{#- Standard clock and reset process -#}
{% macro clk_rst_process(state_var="state", reset_state="IDLE") %}
always @(posedge clk) begin
    if (rst) begin
        {{ state_var }} <= {{ reset_state }};
    end else begin
        {{ state_var }} <= {{ state_var }}_next;
    end
end
{% endmacro %}

{#- Combinational state machine process -#}
{% macro state_machine_comb(state_var="state", states=["IDLE", "PROC", "DONE"]) %}
always @(*) begin
    {{ state_var }}_next = {{ state_var }};
    case ({{ state_var }})
        {% for state in states %}
        {{ state }}: begin
            // {{ state }} state logic
        end
        {% endfor %}
        default: {{ state_var }}_next = {{ states[0] }};
    endcase
end
{% endmacro %}

{#- Counter process with enable and reset -#}
{% macro counter_process(counter_name="cnt", max_val="MAX_COUNT") %}
always @(posedge clk) begin
    if (rst || {{ counter_name }}_rst) begin
        {{ counter_name }} <= 0;
    end else if ({{ counter_name }}_en) begin
        if ({{ counter_name }} == {{ max_val }} - 1) begin
            {{ counter_name }} <= 0;
        end else begin
            {{ counter_name }} <= {{ counter_name }} + 1;
        end
    end
end
{% endmacro %}

{#- Data processing pipeline stage -#}
{% macro pipeline_stage(stage_name, input_data, output_data, valid_in, valid_out, ready_in, ready_out) %}
always @(posedge clk) begin
    if (rst) begin
        {{ output_data }} <= 0;
        {{ valid_out }} <= 1'b0;
    end else if ({{ ready_out }}) begin
        if ({{ valid_in }} && {{ ready_in }}) begin
            {{ output_data }} <= {{ input_data }}; // Process data here
            {{ valid_out }} <= 1'b1;
        end else begin
            {{ valid_out }} <= 1'b0;
        end
    end
end

assign {{ ready_in }} = {{ ready_out }} || !{{ valid_out }};
{% endmacro %}

{#- Memory read process -#}
{% macro memory_read_process(mem_name="mem", addr_sig="addr", data_sig="data", valid_sig="valid") %}
always @(posedge clk) begin
    if (rst) begin
        {{ data_sig }} <= 0;
        {{ valid_sig }} <= 1'b0;
    end else begin
        {{ data_sig }} <= {{ mem_name }}_dout;
        {{ valid_sig }} <= {{ mem_name }}_re;
    end
end
{% endmacro %}

{#- Memory write process -#}
{% macro memory_write_process(mem_name="mem", addr_sig="addr", data_sig="data", we_sig="we") %}
always @(posedge clk) begin
    if ({{ we_sig }}) begin
        {{ mem_name }}[{{ addr_sig }}] <= {{ data_sig }};
    end
end
{% endmacro %}

{#- Ready/valid handshake logic -#}
{% macro handshake_logic(prefix="") %}
assign {{ prefix }}ready = {{ prefix }}out_ready || !{{ prefix }}out_valid;

always @(posedge clk) begin
    if (rst) begin
        {{ prefix }}out_valid <= 1'b0;
    end else if ({{ prefix }}ready) begin
        {{ prefix }}out_valid <= {{ prefix }}in_valid;
    end
end
{% endmacro %}

{#- PE array instantiation process -#}
{% macro pe_array_process(pe_count, pe_module_name="pe_unit") %}
genvar i;
generate
    for (i = 0; i < {{ pe_count }}; i = i + 1) begin : pe_array
        {{ pe_module_name }} pe_inst (
            .clk(clk),
            .rst(rst),
            .in_data(pe_in[i]),
            .in_valid(pe_valid_in[i]),
            .in_ready(pe_ready_in[i]),
            .out_data(pe_out[i]),
            .out_valid(pe_valid_out[i]),
            .out_ready(pe_ready_out[i])
        );
    end
endgenerate
{% endmacro %}

{#- Output assignment process -#}
{% macro output_assignment(data_sig="out_data", valid_sig="out_valid", internal_data="proc_data", internal_valid="proc_valid") %}
always @(posedge clk) begin
    if (rst) begin
        {{ data_sig }} <= 0;
        {{ valid_sig }} <= 1'b0;
    end else begin
        {{ data_sig }} <= {{ internal_data }};
        {{ valid_sig }} <= {{ internal_valid }};
    end
end
{% endmacro %}