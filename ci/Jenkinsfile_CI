node('finn-build || built-in') {
    def app
    stage('Clone repository') {
        /* Let's make sure we have the repository cloned to our workspace */
        checkout scm
    }
    withEnv([
        "FINN_XILINX_PATH=/proj/xbuilds/SWIP/2022.2_1014_8888/installs/lin64",
        "FINN_XILINX_VERSION=2022.2",
        "FINN_HOST_BUILD_DIR=/scratch/users/finn_ci",
        "PLATFORM_REPO_PATHS=/opt/xilinx/platforms"
    ]){
        parallel firstBranch: {
            stage('Brevitas export') {
                dir("${env.WORKSPACE}") {
                sh("./docker/run -- pytest -mbrevitas_export")
                }
            }
        }, secondBranch: {
            stage('Streamlining transformations') {
                dir("${env.WORKSPACE}") {
                sh("./docker/run -- pytest -mstreamline")
                }
            }
        }, thirdBranch: {
            stage('Util functions') {
                dir("${env.WORKSPACE}") {
                sh("./docker/run -- pytest -mutil")
                }
            }
        }, fourthBranch: {
            stage('General transformations') {
                dir("${env.WORKSPACE}") {
                sh("./docker/run -- pytest -mtransform")
                }
            }
        }, fifthBranch: {
            stage('Fpgadataflow transformations and simulations') {
                dir("${env.WORKSPACE}") {
                sh("./docker/run --fpga -- pytest -mfpgadataflow")
                }
            }
        }
    }
}
